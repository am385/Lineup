@using Lineup.App.Web.Services

<section class="mt-3" data-resource-stage="@Stage.Kind">
    <h6>@Text["Resources_Heading"]</h6>
    @if (!Snapshot.Collecting)
    {
        <p>@Text["Resources_Paused"]</p>
    }
    else if (Stage.ResourceIds.Count == 0)
    {
        <p>@Text[Stage.Kind is StreamingFlowStageKind.Consumer
            ? "Resources_External" : Stage.Kind is StreamingFlowStageKind.Multiplexer or StreamingFlowStageKind.VirtualOutput
                ? "Resources_SharedHost" : "Resources_NoProcess"]</p>
    }
    else
    {
        <p class="small text-body-secondary">@Text["Resources_SharedCost"]</p>
        <div class="table-responsive">
            <table class="table table-sm" style="table-layout:fixed;min-width:42rem;overflow-wrap:anywhere;font-variant-numeric:tabular-nums">
                <colgroup>
                    <col style="width:28%" />
                    <col style="width:12%" />
                    <col style="width:12%" />
                    <col style="width:18%" />
                    <col style="width:30%" />
                </colgroup>
                <thead><tr><th>@Text["Resources_Role"]</th><th>PID</th><th>@Text["Resources_Cpu"]</th><th>@Text["Resources_Memory"]</th><th>@Text["Resources_Observed"]</th></tr></thead>
                <tbody>
                    @foreach (var id in Stage.ResourceIds.Distinct(StringComparer.Ordinal))
                    {
                        var process = Snapshot.Processes.FirstOrDefault(item => item.Id == id);
                        <tr data-resource-id="@id">
                            <td>@(process is null ? Text["Common_NotAvailable"] : Text[$"Resources_Role_{process.Role}"])</td>
                            <td>@process?.ProcessId</td>
                            <td>@(process?.CpuPercent is { } cpu ? $"{cpu:0.##}%" : Text["Common_NotAvailable"].Value)</td>
                            <td>@(process?.ResidentBytes is { } bytes ? $"{bytes / (1024d * 1024d):0.##} MiB" : Text["Common_NotAvailable"].Value)</td>
                            <td>@(process is null ? Text["Common_NotAvailable"].Value : process.UnavailableReason is { } reason
                                ? Text[$"Resources_State_{reason}"].Value : FormatObservation(process.ObservedAtUtc))</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="small">@Text["Resources_ProcessScope"]</p>
    }
    @if (Snapshot.Collecting && (Stage.Kind is StreamingFlowStageKind.SourceProcessing or StreamingFlowStageKind.OutputProcessing))
    {
        <section class="mt-3" data-resource-gpu>
            <h6>@Text["Resources_Gpu"]</h6>
            <p class="small text-body-secondary">@Text["Resources_GpuScope"]</p>
            @if (Snapshot.Gpu?.Devices is { Count: > 0 } devices)
            {
                @if (Snapshot.Gpu.UnavailableReason is { } reason)
                {
                    <p role="status">@Text[$"Resources_GpuState_{reason}"]</p>
                }
                <div class="table-responsive">
                    <table class="table table-sm" aria-label="@Text["Resources_Gpu"]"
                           style="table-layout:fixed;min-width:42rem;overflow-wrap:anywhere;font-variant-numeric:tabular-nums" data-resource-gpu-table>
                        <colgroup>
                            <col style="width:32%" />
                            <col style="width:17%" />
                            <col style="width:17%" />
                            <col style="width:17%" />
                            <col style="width:17%" />
                        </colgroup>
                        <thead>
                            <tr>
                                <th>@Text["Resources_Gpu"]</th>
                                <th>@Text["Resources_GpuActivity"]</th>
                                <th>@Text["Resources_GpuEncode"]</th>
                                <th>@Text["Resources_GpuDecode"]</th>
                                <th>@Text["Resources_GpuVideo"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var device in devices)
                            {
                                <tr data-resource-gpu-device="@device.Id" @key="device.Id">
                                    <td>
                                        @device.Name
                                        @if (device.UnavailableReason is { } deviceReason)
                                        {
                                            <div role="status">@Text[$"Resources_GpuState_{deviceReason}"]</div>
                                        }
                                    </td>
                                    <td>@FormatGpuPercent(device, device.Utilization)</td>
                                    <td>@FormatGpuPercent(device, device.SharedVideo ? null : device.Encode)</td>
                                    <td>@FormatGpuPercent(device, device.SharedVideo ? null : device.Decode)</td>
                                    <td>
                                        @FormatGpuPercent(device, device.Video)
                                        @if (device.SharedVideo)
                                        {
                                            <div class="small">@Text["Resources_GpuVideoShared"]</div>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p role="status">@Text["Common_NotAvailable"] · @Text[$"Resources_GpuState_{Snapshot.Gpu?.UnavailableReason ?? "warming_up"}"]</p>
            }
        </section>
    }
</section>

@code {
    /// <summary>Gets or sets the selected stage's resource references.</summary>
    [Parameter, EditorRequired]
    public StreamingFlowPathStage Stage { get; set; } = default!;

    /// <summary>Gets or sets the management owner's cached process and whole-device GPU observations.</summary>
    [Parameter]
    public DashboardResourceSnapshot Snapshot { get; set; } = new(false, [], []);

    private string FormatGpuPercent(GpuResourceSample device, double? value) =>
        device.UnavailableReason is null && value is { } observed ? $"{observed:0.##}%" : Text["Common_NotAvailable"].Value;

    private static string FormatObservation(DateTimeOffset observed) =>
        $"{observed.UtcDateTime:HH:mm:ss} UTC ({Math.Max(0, (DateTimeOffset.UtcNow - observed).TotalSeconds):0.#} s)";
}
