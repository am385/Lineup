<section class="mt-3" data-flow-stage="@Stage.Kind">
    @if (Stage.Kind is StreamingFlowStageKind.SourceProcessing or StreamingFlowStageKind.OutputProcessing)
    {
        <div class="d-flex flex-wrap align-items-center gap-2">
            <VideoEncoderBadge Encoding="Stage.VideoEncoding" ShowOperation="@(Stage.Processing is null)" />
            <StreamProcessingBadges Outcomes="@(Stage.Processing is { } processing ? new[] { processing } : [])"
                                    ShowVideo="@(Stage.Processing is not null)" ShowTracks="true" />
        </div>
    }
    <div class="streaming-flow-stage-media">
        @if (Stage.Kind is StreamingFlowStageKind.SourceProcessing or StreamingFlowStageKind.OutputProcessing)
        {
            <div>
                <h6>@Text[Stage.Kind == StreamingFlowStageKind.SourceProcessing ? "Streaming_RawPhysicalInput" : "Streaming_SourceStreamComponents"]</h6>
                <StreamMediaDetails Media="Stage.InputMedia" />
            </div>
        }
        <div>
            <h6>@GetOutputMediaTitle()</h6>
            <StreamMediaDetails Media="Stage.OutputMedia" />
        </div>
    </div>
</section>

@code {
    /// <summary>Gets or sets the session stage whose encoder and media are rendered below the consolidated node metadata.</summary>
    [Parameter, EditorRequired]
    public StreamingFlowPathStage Stage { get; set; } = default!;

    private string GetOutputMediaTitle() => Stage.Kind switch
    {
        StreamingFlowStageKind.PhysicalSource => Text["Streaming_RawPhysicalStreamComponents"],
        StreamingFlowStageKind.SourceProcessing => Text["Streaming_EffectiveSourceComponents"],
        StreamingFlowStageKind.VirtualOutput => Text["Streaming_SubscribedStreamComponents"],
        StreamingFlowStageKind.OutputProcessing => Text["Streaming_OutputStreamComponents"],
        StreamingFlowStageKind.Consumer => Text["Streaming_DeliveredStreamComponents"],
        _ => Text["Streaming_StreamComponents"]
    };
}
