@using Lineup.Core.Common.Guides

@if (Diagnostics.Count > 0)
{
    <div class="alert alert-warning m-3" role="status" data-guide-source-warnings>
        <strong>@Text["Guide_PartialResults"]</strong>
        <ul class="mb-0">
            @foreach (var diagnostic in Diagnostics)
            {
                <li data-guide-source-id="@diagnostic.SourceId">@diagnostic.SourceName: @diagnostic.Message</li>
            }
        </ul>
    </div>
}

@code {
    /// <summary>Gets or sets the enabled-source exclusions affecting the displayed guide.</summary>
    [Parameter]
    public IReadOnlyList<GuideSourceDiagnostic> Diagnostics { get; set; } = [];
}
