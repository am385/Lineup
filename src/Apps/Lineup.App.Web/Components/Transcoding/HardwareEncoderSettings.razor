@inject IHardwareEncoderDeviceDiscovery DeviceDiscovery

<div class="hardware-encoder-settings row g-3">
    <div class="col-md-6">
        <label for="@(IdPrefix + "Encoder")" class="form-label">@Text["Transcoding_HardwareEncoder"]</label>
        <select id="@(IdPrefix + "Encoder")" class="form-select" @bind:get="Value.Encoder" @bind:set="SetEncoderAsync">
            @foreach (var encoder in Enum.GetValues<HardwareVideoEncoder>())
            {
                <option value="@encoder">@EncoderLabel(encoder)</option>
            }
        </select>
        <div class="form-text">@Text["Transcoding_HardwareHelp"]</div>
    </div>
    @if (Value.Encoder != HardwareVideoEncoder.Software)
    {
        <div class="col-md-6">
            <label for="@(IdPrefix + "Device")" class="form-label">@Text["Transcoding_HardwareDevice"]</label>
            <select id="@(IdPrefix + "Device")" class="form-select" disabled="@_loadingDevices" @bind:get="SelectedDevice" @bind:set="SelectDeviceAsync">
                <option value="">@Text["Transcoding_HardwareDeviceDefault"]</option>
                @foreach (var device in _devices.Devices)
                {
                    <option value="@device.Value">@device.Label</option>
                }
                @if (Value.Encoder != HardwareVideoEncoder.VideoToolbox)
                {
                    <option value="@CustomDevice">@Text["Transcoding_HardwareDeviceCustom"]</option>
                }
            </select>
            @if (_customDevice || Value.Device.Length > 0 && !_devices.Devices.Any(device => device.Value == Value.Device))
            {
                <label for="@(IdPrefix + "CustomDevice")" class="form-label mt-2">@Text["Transcoding_HardwareDeviceCustom"]</label>
                <input id="@(IdPrefix + "CustomDevice")" class="form-control" maxlength="256" @bind:get="Value.Device" @bind:set="SetDeviceAsync" />
                <div class="form-text">@Text["Transcoding_HardwareDeviceHelp"]</div>
            }
            <div class="form-text">@Text["Transcoding_HardwareDeviceDetectedHelp"]</div>
            @if (_loadingDevices)
            {
                <div class="form-text" role="status">@Text["Transcoding_HardwareDeviceLoading"]</div>
            }
            else if (_devices.DiscoveryFailed)
            {
                <div class="form-text text-warning" role="status">@Text["Transcoding_HardwareDeviceDiscoveryFailed"]</div>
            }
            else if (_devices.Devices.Count == 0 && Value.Encoder != HardwareVideoEncoder.VideoToolbox)
            {
                <div class="form-text" role="status">@Text["Transcoding_HardwareDeviceNone"]</div>
            }
        </div>
        <div class="col-md-6">
            <label for="@(IdPrefix + "Tuning")" class="form-label">@Text["Transcoding_HardwareTuning"]</label>
            <select id="@(IdPrefix + "Tuning")" class="form-select" @bind:get="Value.Tuning" @bind:set="SetTuningAsync">
                @foreach (var tuning in Enum.GetValues<HardwareEncoderTuning>().Where(tuning => Value.Encoder != HardwareVideoEncoder.Vaapi || tuning == HardwareEncoderTuning.Balanced))
                {
                    <option value="@tuning">@Text[$"Transcoding_HardwareTuning{tuning}"]</option>
                }
            </select>
        </div>
        <div class="col-md-6">
            <div class="form-check mt-4">
                <input id="@(IdPrefix + "Fallback")" class="form-check-input" type="checkbox" @bind:get="Value.AllowSoftwareFallback" @bind:set="SetFallbackAsync" />
                <label for="@(IdPrefix + "Fallback")" class="form-check-label">@Text["Transcoding_HardwareFallback"]</label>
            </div>
            <div class="form-text">@Text["Transcoding_HardwareFallbackHelp"]</div>
        </div>
        <div class="col-12">
            <label for="@(IdPrefix + "Arguments")" class="form-label">@Text["Transcoding_HardwareArguments"]</label>
            <textarea id="@(IdPrefix + "Arguments")" class="form-control font-monospace" rows="3" maxlength="4096"
                      @bind:get="Value.AdvancedArguments" @bind:set="SetArgumentsAsync"></textarea>
            <div class="form-text">@Text["Transcoding_HardwareArgumentsHelp"]</div>
        </div>
    }
</div>

@code {
    /// <summary>Gets or sets the immutable hardware encoding configuration.</summary>
    [Parameter, EditorRequired]
    public HardwareEncodingSettings Value { get; set; } = new();

    /// <summary>Gets or sets the configuration change notification.</summary>
    [Parameter]
    public EventCallback<HardwareEncodingSettings> ValueChanged { get; set; }

    /// <summary>Gets or sets the unique form identifier prefix.</summary>
    [Parameter, EditorRequired]
    public string IdPrefix { get; set; } = string.Empty;

    private const string CustomDevice = "custom";
    private HardwareEncoderDeviceSnapshot _devices = new([]);
    private HardwareVideoEncoder? _discoveredEncoder;
    private bool _customDevice;
    private bool _loadingDevices;
    private string SelectedDevice => _customDevice || Value.Device.Length > 0 && !_devices.Devices.Any(device => device.Value == Value.Device) ? CustomDevice : Value.Device;

    /// <inheritdoc />
    protected override async Task OnParametersSetAsync()
    {
        var encoder = Value.Encoder;
        if (_discoveredEncoder == encoder) return;
        _discoveredEncoder = encoder;
        _customDevice = false;
        _devices = new([]);
        _loadingDevices = true;
        var snapshot = await DeviceDiscovery.GetDevicesAsync(encoder);
        if (_discoveredEncoder != encoder) return;
        _devices = snapshot;
        _loadingDevices = false;
    }

    private Task SelectDeviceAsync(string device)
    {
        _customDevice = device == CustomDevice;
        return _customDevice ? Task.CompletedTask : SetDeviceAsync(device);
    }

    private string EncoderLabel(HardwareVideoEncoder encoder) => encoder switch
    {
        HardwareVideoEncoder.Software => Text["Transcoding_SoftwareEncoder"],
        HardwareVideoEncoder.Qsv => "Intel QSV",
        HardwareVideoEncoder.Nvenc => "NVIDIA NVENC",
        HardwareVideoEncoder.Vaapi => "VA-API",
        HardwareVideoEncoder.Amf => "AMD AMF",
        HardwareVideoEncoder.VideoToolbox => "Apple VideoToolbox",
        _ => encoder.ToString()
    };

    private Task SetEncoderAsync(HardwareVideoEncoder encoder) =>
        ValueChanged.InvokeAsync(Value with { Encoder = encoder, Device = string.Empty, AdvancedArguments = string.Empty, Tuning = HardwareEncoderTuning.Balanced });
    private Task SetDeviceAsync(string device) => ValueChanged.InvokeAsync(Value with { Device = device });
    private Task SetTuningAsync(HardwareEncoderTuning tuning) => ValueChanged.InvokeAsync(Value with { Tuning = tuning });
    private Task SetFallbackAsync(bool fallback) => ValueChanged.InvokeAsync(Value with { AllowSoftwareFallback = fallback });
    private Task SetArgumentsAsync(string arguments) => ValueChanged.InvokeAsync(Value with { AdvancedArguments = arguments });
}
