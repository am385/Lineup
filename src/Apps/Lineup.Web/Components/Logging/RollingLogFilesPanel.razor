@using Lineup.Web.Services

<div class="card">
    <div class="card-header">
        <h5 class="mb-0">Rolling Log Files</h5>
    </div>
    <div class="card-body">
        @if (!Enabled)
        {
            <p class="mb-0">File logging is disabled. Enable it under <a href="/settings#logging">Settings &gt; Logging</a> and restart Lineup to retain logs across restarts.</p>
        }
        else if (Files.Count == 0)
        {
            <p class="text-body-secondary mb-0">No rolling log files are available yet.</p>
        }
        else
        {
            <div class="list-group">
                @foreach (var file in Files)
                {
                    <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center" href="@($"/api/logs/files/{Uri.EscapeDataString(file.Name)}")">
                        <span><span class="bi bi-download me-2"></span>@file.Name</span>
                        <small class="text-body-secondary">@FormatFileSize(file.Size) · @file.LastModifiedUtc.ToLocalTime().ToString("g")</small>
                    </a>
                }
            </div>
        }
    </div>
</div>

@code {
    /// <summary>Gets or sets whether rolling file logging is enabled.</summary>
    [Parameter]
    public bool Enabled { get; set; }

    /// <summary>Gets or sets the available rolling log files.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<LogFileInfo> Files { get; set; } = [];

    private static string FormatFileSize(long bytes)
    {
        if (bytes >= 1024 * 1024)
        {
            return $"{bytes / (1024d * 1024d):0.0} MB";
        }

        return bytes >= 1024 ? $"{bytes / 1024d:0.0} KB" : $"{bytes} B";
    }
}
