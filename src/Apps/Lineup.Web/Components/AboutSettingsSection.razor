<section class="about-settings-section">
    <h6 class="fw-semibold mb-1">@Title</h6>
    <div class="mb-0">@ChildContent</div>
</section>

@code {
    /// <summary>Gets or sets the consistently formatted section heading.</summary>
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    /// <summary>Gets or sets the section overview content.</summary>
    [Parameter, EditorRequired]
    public RenderFragment ChildContent { get; set; } = default!;
}
