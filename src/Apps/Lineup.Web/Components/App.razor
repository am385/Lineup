<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/shaka-player@5.2.11/dist/controls.css"
          integrity="sha384-U/1YJ0qAHHgnh2/Kn+KM9OTVDkUMy0VkOO1YWROI4ZsLuhhP7WZ48YYAYGeBVo+J"
          crossorigin="anonymous" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["Lineup.Web.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    <HeadOutlet @rendermode="InteractiveServer" />
    <!-- Shaka provides shared CMAF HLS/DASH playback. -->
    <script src="https://cdn.jsdelivr.net/npm/shaka-player@5.2.11/dist/shaka-player.ui.js"
            integrity="sha384-ghyp/QciHlmviIclg7x6TA6ickR8CIKZTrHD0TLFcsm+CNLHnmUOCCmvguhuQydN"
            crossorigin="anonymous"></script>
    <script>
        // This must read localStorage before Blazor and BrowserDataStore are available to prevent a flash of the wrong theme.
        (function() {
            var theme = localStorage.getItem('app-theme') || 'auto';
            var resolved = theme;
            if (theme === 'auto') {
                resolved = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
            }
            document.documentElement.setAttribute('data-bs-theme', resolved);
        })();
    </script>
</head>

<body>
<Routes @rendermode="InteractiveServer" />
<ReconnectModal />
<script src="@Assets["lib/bootstrap/dist/js/bootstrap.bundle.min.js"]"></script>
<script src="@Assets["js/browser-utilities.js"]"></script>
<script src="@Assets["js/runtime-watch.js"]"></script>
<script src="@Assets["js/cmaf-playback.js"]"></script>
<script src="@Assets["js/guide-viewport.js"]"></script>
<script src="@Assets["js/theme.js"]"></script>
<script>
    // Register Blazor start callback before loading blazor.web.js.
    // This ensures we can hook into Blazor's enhanced navigation lifecycle.
    window.blazorCallbacks = {
        afterWebStarted: function() {
            Blazor.addEventListener('enhancedload', function() {
                applyTheme();
            });
        }
    };
</script>
<script src="@Assets["_framework/blazor.web.js"]" autostart="false"></script>
<script>
    // Start Blazor manually with the afterStarted callback
    Blazor.start().then(function() {
        if (window.blazorCallbacks && window.blazorCallbacks.afterWebStarted) {
            window.blazorCallbacks.afterWebStarted();
        }
    });
</script>
</body>

</html>
