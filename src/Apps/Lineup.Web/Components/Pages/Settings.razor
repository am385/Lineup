@page "/settings"
@using Lineup.Core.Streaming
@using Lineup.LineupLink.Protocol
@using Lineup.Web.Components.Transcoding
@using Lineup.Web.Services

<PageTitle>Settings</PageTitle>

@if (_isRestarting || _isFactoryResetting)
{
    <div id="factoryResetRestartOverlay" class="position-fixed top-0 start-0 w-100 h-100 bg-body d-flex align-items-center justify-content-center p-4" style="z-index: 2000;" role="status" aria-live="assertive">
        <div class="text-center" style="max-width: 32rem;">
            <div id="factoryResetRestartProgress">
                <div class="spinner-border text-primary mb-3" style="width: 3rem; height: 3rem;" aria-hidden="true"></div>
                <h1 class="h3">Restarting Lineup</h1>
                @if (_isFactoryResetting)
                {
                    <p class="text-body-secondary mb-0">Factory reset is complete. Lineup will return to Device setup automatically when it is ready.</p>
                }
                else
                {
                    <p class="text-body-secondary mb-0">Lineup will return to this page automatically when it is ready.</p>
                }
            </div>
            <div id="factoryResetRestartTimeout" class="d-none">
                <span class="bi bi-exclamation-circle text-warning fs-1" aria-hidden="true"></span>
                <h1 class="h3 mt-3">Lineup is taking longer than expected</h1>
                <p class="text-body-secondary">Make sure Lineup is running, then try connecting again.</p>
                <button id="retryFactoryResetRestart" type="button" class="btn btn-primary" onclick="retryLineupFactoryResetWatch()">
                    <span class="bi bi-arrow-clockwise me-1"></span>Retry
                </button>
            </div>
        </div>
    </div>
}

<h1><span class="bi bi-gear me-2"></span>Settings</h1>

@if (StartupState.IsFactoryResetRequired)
{
    <div id="factoryResetRequired" class="alert alert-danger mb-4" role="alert">
        <h5 class="alert-heading"><span class="bi bi-exclamation-triangle me-2"></span>Factory reset required</h5>
        <p>@StartupState.Reason</p>
        <p class="mb-0">Normal device, guide, discovery, and streaming operations are disabled. Use the Reset tab below to explicitly erase incompatible state and restart Lineup.</p>
    </div>
}

@if (_isInitialSetup)
{
    <div class="alert alert-primary mb-4">
        <h5 class="alert-heading"><span class="bi bi-rocket-takeoff me-2"></span>Welcome to Lineup!</h5>
        <p class="mb-0">Add a <strong>Physical Device</strong> and <strong>Guide Source</strong>, optionally add a <strong>Virtual Device</strong>, then click <strong>Save Settings</strong> to get started.</p>
    </div>
}

<ul id="settingsCategoryTabs" class="nav nav-tabs mb-4" role="tablist" aria-label="Settings categories">
    <li class="nav-item" role="presentation">
        <button id="tab-general" type="button" class="@GetTabButtonClass(SettingsTab.General)" role="tab"
                aria-selected="@(_activeTab == SettingsTab.General)" @onclick="() => SelectTab(SettingsTab.General)">
            <span class="bi bi-sliders me-1"></span>General
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button id="tab-dashboard" type="button" class="@GetTabButtonClass(SettingsTab.Dashboard)" role="tab"
                aria-selected="@(_activeTab == SettingsTab.Dashboard)" @onclick="() => SelectTab(SettingsTab.Dashboard)">
            <span class="bi bi-speedometer2 me-1"></span>Dashboard
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button id="tab-guide" type="button" class="@GetTabButtonClass(SettingsTab.Guide)" role="tab"
                aria-selected="@(_activeTab == SettingsTab.Guide)" @onclick="() => SelectTab(SettingsTab.Guide)">
            <span class="bi bi-calendar3 me-1"></span>Guide Sources
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button id="tab-guide-outputs" type="button" class="@GetTabButtonClass(SettingsTab.GuideOutputs)" role="tab"
                aria-selected="@(_activeTab == SettingsTab.GuideOutputs)" @onclick="() => SelectTab(SettingsTab.GuideOutputs)">
            <span class="bi bi-file-earmark-code me-1"></span>Guide Outputs
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button id="tab-physical-devices" type="button" class="@GetTabButtonClass(SettingsTab.PhysicalDevices)" role="tab"
                aria-selected="@(_activeTab == SettingsTab.PhysicalDevices)" @onclick="() => SelectTab(SettingsTab.PhysicalDevices)">
            <span class="bi bi-broadcast-pin me-1"></span>Physical Devices
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button id="tab-virtual-devices" type="button" class="@GetTabButtonClass(SettingsTab.VirtualDevices)" role="tab"
                aria-selected="@(_activeTab == SettingsTab.VirtualDevices)" @onclick="() => SelectTab(SettingsTab.VirtualDevices)">
            <span class="bi bi-hdd-network me-1"></span>Virtual Devices
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button id="tab-streaming" type="button" class="@GetTabButtonClass(SettingsTab.Streaming)" role="tab"
                aria-selected="@(_activeTab == SettingsTab.Streaming)" @onclick="() => SelectTab(SettingsTab.Streaming)">
            <span class="bi bi-broadcast me-1"></span>Streaming
        </button>
    </li>
    @if (!_isInitialSetup)
    {
        <li class="nav-item" role="presentation">
            <button id="tab-api" type="button" class="@GetTabButtonClass(SettingsTab.Api)" role="tab"
                    aria-selected="@(_activeTab == SettingsTab.Api)" @onclick="() => SelectTab(SettingsTab.Api)">
                <span class="bi bi-braces me-1"></span>API
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button id="tab-logging" type="button" class="@GetTabButtonClass(SettingsTab.Logging)" role="tab"
                    aria-selected="@(_activeTab == SettingsTab.Logging)" @onclick="() => SelectTab(SettingsTab.Logging)">
                <span class="bi bi-journal-text me-1"></span>Logging
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button id="tab-reset" type="button" class="@GetTabButtonClass(SettingsTab.Reset)" role="tab"
                    aria-selected="@(_activeTab == SettingsTab.Reset)" @onclick="() => SelectTab(SettingsTab.Reset)">
                <span class="bi bi-arrow-counterclockwise me-1"></span>Reset
            </button>
        </li>
    }
</ul>

<div id="settingsContent" class="row">
    <div class="col-md-8">
        <GeneralSettingsTab CssClass="@GetTabPaneClass(SettingsTab.General)"
                            @bind-Theme="_theme"
                            @bind-TimeZoneId="_timeZoneId"
                            CurrentTimeZoneDisplayName="@TimeZoneService.TimeZone.DisplayName" />

        <GuideSourcesSettingsTab Host="this" CssClass="@GetTabPaneClass(SettingsTab.Guide)" />

        <GuideOutputsSettingsTab Host="this" CssClass="@GetTabPaneClass(SettingsTab.GuideOutputs)" />

        <PhysicalDevicesSettingsTab Host="this" CssClass="@GetTabPaneClass(SettingsTab.PhysicalDevices)" />

        <VirtualDevicesSettingsTab Host="this" CssClass="@GetTabPaneClass(SettingsTab.VirtualDevices)" />

                <StreamingSettingsTab CssClass="@GetTabPaneClass(SettingsTab.Streaming)"
                              @bind-MaximumConcurrentStreams="_maximumConcurrentStreams"
                              @bind-KeepWarmPeriodSeconds="_topology.KeepWarmPeriodSeconds"
                              @bind-ProtectedContentMode="_protectedContentMode"
                              @bind-DisabledChannelMode="_disabledChannelMode" />

        <DashboardSettingsTab CssClass="@GetTabPaneClass(SettingsTab.Dashboard)"
                              @bind-ActiveStreamRefreshIntervalSeconds="_activeStreamRefreshIntervalSeconds" />

        @if (!_isInitialSetup)
        {
            <ApiSettingsTab CssClass="@GetTabPaneClass(SettingsTab.Api)"
                            @bind-RedactClientAddresses="_redactApiClientAddresses"
                            @bind-RedactDeviceAddresses="_redactApiDeviceAddresses"
                            @bind-RedactUrls="_redactApiUrls" />

            <LoggingSettingsTab CssClass="@GetTabPaneClass(SettingsTab.Logging)"
                                @bind-OverrideLoggingDefaults="_overrideLoggingDefaults"
                                @bind-ApplicationLogLevel="_applicationLogLevel"
                                ApplicationLogLevels="ApplicationLogLevels"
                                CategoryOverrides="_logCategoryOverrides"
                                StartupCategories="_startupLogCategories"
                                @bind-EnableFileLogging="_enableFileLogging"
                                @bind-FileLogLevel="_fileLogLevel"
                                @bind-FileLogRetentionDays="_fileLogRetentionDays"
                                @bind-FileLogSizeLimitMb="_fileLogSizeLimitMb"
                                Runtime="LoggingRuntime"
                                RetainedFiles="_retainedLogFiles"
                                IsDeletingLogs="_isDeletingLogs"
                                AddCategoryRequested="AddLogCategoryOverride"
                                RemoveCategoryRequested="RemoveLogCategoryOverride"
                                DeleteLogsRequested="DeleteLogs" />

            <ResetSettingsTab CssClass="@GetTabPaneClass(SettingsTab.Reset)"
                              IsRestarting="_isRestarting"
                              ShowFactoryResetConfirmation="_showFactoryResetConfirmation"
                              @bind-FactoryResetConfirmed="_factoryResetConfirmed"
                              IsFactoryResetting="_isFactoryResetting"
                              CanFactoryReset="CanFactoryReset"
                              ResetDefaultsRequested="ResetToDefaults"
                              RestartRequested="RestartLineup"
                              ShowFactoryResetRequested="ShowFactoryResetConfirmation"
                              FactoryResetRequested="FactoryReset"
                              CancelFactoryResetRequested="CancelFactoryReset" />
        }

        @if (_activeTab != SettingsTab.Reset)
        {
            <div class="d-flex gap-2">
                <button class="btn btn-primary" @onclick="SaveSettings" disabled="@_isSaving">
                    @if (_isSaving)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                    }
                    <span class="bi bi-save me-1"></span>@(_isInitialSetup ? "Save & Get Started" : "Save Settings")
                </button>
                @if (!_isInitialSetup)
                {
                    <button id="undoSettings" class="btn btn-outline-secondary" @onclick="UndoUnsavedChanges">
                        <span class="bi bi-arrow-counterclockwise me-1"></span>Undo
                    </button>
                }
                <button class="btn btn-outline-secondary" @onclick="Cancel">
                    @(_isInitialSetup ? "Skip" : "Cancel")
                </button>
            </div>
        }

    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0"><span class="bi bi-info-circle me-1"></span>About Settings</h5>
            </div>
            <div id="aboutSettingsBody" class="card-body">
                <div class="d-grid gap-3">
                    @if (_activeTab == SettingsTab.General)
                    {
                        <AboutSettingsSection Title="Appearance">
                            Controls how the Web interface is presented without changing shared streaming or guide behavior.
                        </AboutSettingsSection>
                        <AboutSettingsSection Title="Regional Settings">
                            Controls how dates and times are displayed throughout Lineup. It does not change program timestamps stored by guide providers.
                        </AboutSettingsSection>
                    }
                    else if (_activeTab == SettingsTab.Guide)
                    {
                        @if (_selectedGuideSourceId is null)
                        {
                            <AboutSettingsSection Title="EPG Fetch Settings">
                                Controls the shared guide-refresh schedule, whether physical channel lineups are refreshed first, and how much completed program history is retained.
                            </AboutSettingsSection>
                            <AboutSettingsSection Title="XMLTV Output Settings">
                                Publishes the combined guide for external consumers only after a refresh completes, so readers never receive a partially updated document.
                            </AboutSettingsSection>
                        }
                        else if (_activeTab == SettingsTab.GuideOutputs)
                        {
                            <AboutSettingsSection Title="Guide Outputs">
                                Publishes cached guide data for all enabled virtual devices by default. Create scoped outputs when a downstream consumer needs only selected virtual devices or guide sources.
                            </AboutSettingsSection>
                        }
                        else
                        {
                            var source = _topology.GuideSources.FirstOrDefault(candidate => candidate.Id == _selectedGuideSourceId);
                            if (source is not null)
                            {
                                var sourceName = string.IsNullOrWhiteSpace(source.Name) ? GetGuideSourceTypeName(source) : source.Name;
                                <AboutSettingsSection Title="Guide Source Settings">
                                    Configures @sourceName, a @GetGuideSourceTypeName(source) instance, and whether it contributes data during guide refreshes.
                                </AboutSettingsSection>
                                <AboutSettingsSection Title="Physical Device Subscription">
                                    Defines which compatible physical devices provide channels and any provider authorization required by this source. Selecting all also includes compatible devices added later.
                                </AboutSettingsSection>
                            }
                        }
                    }
                    else if (_activeTab == SettingsTab.PhysicalDevices)
                    {
                        @if (_selectedPhysicalDeviceId is null)
                        {
                            <AboutSettingsSection Title="Refresh Settings">
                                Controls independent polling schedules for relatively stable device information and frequently changing tuner status. These intervals apply to every physical device.
                            </AboutSettingsSection>
                            <AboutSettingsSection Title="Transcoder Settings">
                                Defines source-stage defaults applied before streams enter the multiplexer. Device tabs can override only the policies required by that source while inheriting the rest.
                            </AboutSettingsSection>
                        }
                        else
                        {
                            var device = _topology.PhysicalDevices.FirstOrDefault(candidate => candidate.Id == _selectedPhysicalDeviceId);
                            if (device is not null)
                            {
                                var deviceName = string.IsNullOrWhiteSpace(device.Name) ? GetPhysicalDeviceTypeName(device) : device.Name;
                                <AboutSettingsSection Title="Device Settings">
                                    Configures @deviceName, a @GetPhysicalDeviceTypeName(device) instance, including its identity, connection, and enabled state. Disabled devices remain configured but do not participate in channel refreshes, guide sources, tuner capacity, or routing.
                                    @if (device.IsHdHomeRun)
                                    {
                                        <span> The connection is made directly from the Lineup host, so the address must be reachable from that host or container.</span>
                                    }
                                    else if (device.IsLineupLink)
                                    {
                                        <span> It imports channels and streams from a remote virtual device; connection bundles contain credentials and must be handled as secrets.</span>
                                    }
                                    else
                                    {
                                        <span> Plugin-provided connection and source options apply only to this instance.</span>
                                    }
                                    <span> Test &amp; Identify validates the current unsaved connection and retrieves safe device identity without saving or activating it.</span>
                                </AboutSettingsSection>
                                <AboutSettingsSection Title="Transcoder Settings">
                                    Overrides source-stage defaults for this device only. Options without an enabled override continue to inherit current and future Physical Device Global Settings.
                                </AboutSettingsSection>
                            }
                        }
                    }
                    else if (_activeTab == SettingsTab.VirtualDevices)
                    {
                        @if (_selectedVirtualDeviceId is null)
                        {
                            <AboutSettingsSection Title="Transcoder Settings">
                                Defines output-stage defaults used to create consumer-specific streams after multiplexing. Virtual-device tabs can override only the policies required by that output.
                            </AboutSettingsSection>
                            <AboutSettingsSection Title="Virtual Tuner Discovery">
                                Controls local-network publication of enabled virtual HDHomeRun devices. The built-in Web Player remains available independently of network discovery.
                            </AboutSettingsSection>
                        }
                        else
                        {
                            var device = _topology.VirtualDevices.FirstOrDefault(candidate => candidate.Id == _selectedVirtualDeviceId);
                            if (device is not null)
                            {
                                var deviceName = string.IsNullOrWhiteSpace(device.Name) ? GetVirtualDeviceTypeName(device) : device.Name;
                                <AboutSettingsSection Title="Device Settings">
                                    Configures @deviceName, a @(device.IsWebPlayer ? "built-in Web Player" : GetVirtualDeviceTypeName(device)) output, including its enabled state and physical-device subscription.
                                    @if (device.IsWebPlayer)
                                    {
                                        <span> The Watch page uses this output, which can be disabled but not removed.</span>
                                    }
                                    else if (device.IsHdHomeRun)
                                    {
                                        <span> It emulates an HDHomeRun, with tuner capacity derived from subscribed physical devices unless explicitly capped.</span>
                                    }
                                    else if (device.IsLineupLink)
                                    {
                                        <span> It securely exposes channels to another Lineup host; exported connection bundles contain credentials and must be handled as secrets.</span>
                                    }
                                    else
                                    {
                                        <span> Plugin-provided identity and output options apply only to this instance.</span>
                                    }
                                </AboutSettingsSection>
                                <AboutSettingsSection Title="Transcoder Settings">
                                    Overrides output-stage defaults for this virtual device only. Options without an enabled override continue to inherit current and future Virtual Device Global Settings.
                                </AboutSettingsSection>
                            }
                        }
                    }
                    else if (_activeTab == SettingsTab.Streaming)
                    {
                        <AboutSettingsSection Title="Streaming Policies">
                            Controls application-wide stream admission, shared-pipeline retention, and responses for streams that cannot deliver normal programming. Physical and virtual transcoder profiles are configured on their device tabs.
                        </AboutSettingsSection>
                    }
                    else if (_activeTab == SettingsTab.Dashboard)
                    {
                        <AboutSettingsSection Title="Active Streams">
                            Controls how frequently the Dashboard refreshes its cached view of consumers, tuner use, shared acquisitions, transcodes, and streaming flow.
                        </AboutSettingsSection>
                    }
                    else if (_activeTab == SettingsTab.Api)
                    {
                        <AboutSettingsSection Title="Status API">
                            Controls privacy redaction for the read-only <code>GET /api/v1/status</code> snapshot. Redacted properties remain present as <code>null</code>, preserving a stable response shape without triggering device or guide operations.
                        </AboutSettingsSection>
                    }
                    else if (_activeTab == SettingsTab.Logging)
                    {
                        <AboutSettingsSection Title="Application Log Filters">
                            Controls Web-managed default and category-specific severity filters for every logging output. Disabling overrides restores the startup configuration.
                        </AboutSettingsSection>
                        <AboutSettingsSection Title="Local Diagnostics">
                            Configures restart-persistent rolling files in addition to the bounded in-memory Logs page, and manages retained diagnostic files.
                        </AboutSettingsSection>
                        <AboutSettingsSection Title="External Targets">
                            External targets such as OTLP are configured at startup so credentials are never persisted or displayed by the Web settings UI.
                        </AboutSettingsSection>
                    }
                    else
                    {
                        <AboutSettingsSection Title="Reset Settings">
                            Stages default shared and Web settings for review without immediately changing persisted configuration.
                        </AboutSettingsSection>
                        <AboutSettingsSection Title="Restart Lineup">
                            Gracefully restarts the host without changing configuration or deleting data.
                        </AboutSettingsSection>
                        <AboutSettingsSection Title="Factory Reset">
                            Permanently removes Lineup-owned configuration and data before restarting into first-run setup. External XMLTV files remain untouched.
                        </AboutSettingsSection>
                    }
                </div>
                <hr />
                <p class="text-muted mb-0">
                    @if (_activeTab is SettingsTab.Dashboard or SettingsTab.Api or SettingsTab.Logging)
                    {
                        <small>These Web-host settings are saved to <code>web-settings.json</code> and persist across restarts.</small>
                    }
                    else if (_activeTab == SettingsTab.General)
                    {
                        <small>Theme is saved to <code>web-settings.json</code>; shared regional settings are saved to <code>settings.json</code>.</small>
                    }
                    else if (_activeTab == SettingsTab.Reset)
                    {
                        <small>Reset operations can affect <code>settings.json</code>, <code>web-settings.json</code>, and other Lineup-owned application data.</small>
                    }
                    else
                    {
                        <small>These shared settings are saved to <code>settings.json</code> and can be used by Web and other Lineup hosts.</small>
                    }
                </p>
            </div>
        </div>
    </div>
</div>
