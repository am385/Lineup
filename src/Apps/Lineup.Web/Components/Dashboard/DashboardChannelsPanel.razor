<div class="card mb-4">
    <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div>
            <h5 class="mb-0"><span class="bi bi-list-check me-1"></span>Channels</h5>
            @if (!Expanded)
            {
                <small class="text-muted">@Summary</small>
            }
        </div>
        <div class="d-flex align-items-center ms-auto">
            <button id="refreshChannels" type="button" class="btn btn-sm btn-outline-primary"
                    @onclick="() => RefreshRequested.InvokeAsync()" disabled="@IsBusy">
                @if (IsRefreshing)
                {
                    <span class="spinner-border spinner-border-sm me-1"></span>
                }
                <span class="bi bi-arrow-clockwise me-1"></span>Refresh Channels
            </button>
            <button id="toggleChannelsSection" type="button" class="btn btn-sm btn-outline-secondary ms-2"
                    aria-expanded="@(Expanded ? "true" : "false")" aria-controls="channelsSection"
                    @onclick="() => ToggleRequested.InvokeAsync()">
                <span class="@(Expanded ? "bi bi-chevron-up" : "bi bi-chevron-down")"></span>
                <span class="visually-hidden">@(Expanded ? "Collapse" : "Expand") Channels section</span>
            </button>
        </div>
    </div>
    <div id="channelsSection" class="card-body" hidden="@(!Expanded)">
        <div class="row text-center">
            <div class="col-md-4 mb-3 mb-md-0">
                <div class="text-muted small">Enabled</div>
                <div class="display-6 text-success">@EnabledCount</div>
            </div>
            <div class="col-md-4 mb-3 mb-md-0">
                <div class="text-muted small">Disabled</div>
                <div class="display-6 text-secondary">@DisabledCount</div>
            </div>
            <div class="col-md-4">
                <div class="text-muted small">Last Updated</div>
                <div class="h5 mt-2 mb-0">@LastUpdated</div>
            </div>
        </div>
    </div>
</div>

@code {
    /// <summary>Gets or sets whether the panel is expanded.</summary>
    [Parameter]
    public bool Expanded { get; set; }

    /// <summary>Gets or sets the collapsed summary.</summary>
    [Parameter, EditorRequired]
    public string Summary { get; set; } = string.Empty;

    /// <summary>Gets or sets whether any dashboard action is busy.</summary>
    [Parameter]
    public bool IsBusy { get; set; }

    /// <summary>Gets or sets whether channel refresh is active.</summary>
    [Parameter]
    public bool IsRefreshing { get; set; }

    /// <summary>Gets or sets the enabled channel count.</summary>
    [Parameter]
    public int EnabledCount { get; set; }

    /// <summary>Gets or sets the disabled channel count.</summary>
    [Parameter]
    public int DisabledCount { get; set; }

    /// <summary>Gets or sets the formatted last update time.</summary>
    [Parameter, EditorRequired]
    public string LastUpdated { get; set; } = string.Empty;

    /// <summary>Gets or sets the callback raised when channel refresh is requested.</summary>
    [Parameter]
    public EventCallback RefreshRequested { get; set; }

    /// <summary>Gets or sets the callback raised when expansion changes.</summary>
    [Parameter]
    public EventCallback ToggleRequested { get; set; }
}
