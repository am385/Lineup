        <div id="physicalDevicesSettingsTab" class="@CssClass" role="tabpanel" aria-labelledby="tab-physical-devices" @onchange="Host.NotifySettingsUiChanged">
            <div id="physicalTopologySettings" class="device-settings-workspace mb-4">
                <div class="d-flex align-items-end gap-2 mb-3">
                    <div class="device-tab-strip flex-grow-1">
                        <ul class="nav nav-tabs flex-nowrap">
                            <li class="nav-item">
                                <button id="physicalSubtabGlobal" type="button"
                                        class="nav-link @(Host.SelectedPhysicalDeviceId is null ? "active" : null)"
                                        @onclick="() => Host.SelectedPhysicalDeviceId = null">
                                    Global Settings
                                </button>
                            </li>
                            @foreach (var device in Host.Topology.PhysicalDevices)
                            {
                                <li class="nav-item">
                                    <button type="button"
                                            class="nav-link physical-device-tab @(Host.SelectedPhysicalDeviceId == device.Id ? "active" : null)"
                                            data-device-id="@device.Id"
                                            @onclick="() => Host.SelectedPhysicalDeviceId = device.Id">
                                        @(string.IsNullOrWhiteSpace(device.Name) ? Host.GetPhysicalDeviceTypeName(device) : device.Name)
                                        @if (!device.Enabled)
                                        {
                                            <span class="badge text-bg-secondary ms-1">Disabled</span>
                                        }
                                    </button>
                                </li>
                            }
                        </ul>
                    </div>
                    <button id="addPhysicalDevice" type="button" class="btn btn-sm btn-outline-primary flex-shrink-0" @onclick="Host.ShowPhysicalDeviceTypePicker">
                        <span class="bi bi-plus-lg me-1"></span>Add Physical Device
                    </button>
                </div>
                @if (Host.Topology.PhysicalDevices.Count == 0)
                {
                    <div id="physicalDevicesEmptyState" class="alert alert-info py-2" role="status">
                        <span class="bi bi-info-circle me-1"></span>No physical devices are configured. Select <strong>Add Physical Device</strong> to make channels available to Lineup.
                    </div>
                }

                @if (Host.SelectedPhysicalDeviceId is null)
                {
                    <div id="physicalGlobalSettings" class="d-grid gap-4">
                        <section id="physicalDeviceRefreshSettings" class="card">
                            <div class="card-header">
                                <h5 class="mb-0">Refresh Settings</h5>
                            </div>
                            <div class="card-body">
                                <p class="small text-body-secondary">These monitoring intervals apply to every physical device.</p>
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label for="deviceRefreshInterval" class="form-label">Device Info Refresh Interval (minutes)</label>
                                        <input type="number" class="form-control" id="deviceRefreshInterval"
                                               @bind="Host.DeviceRefreshIntervalMinutes" min="0" max="60" />
                                        <div class="form-text">How often to refresh device information. Set to 0 to disable auto-refresh.</div>
                                    </div>
                                    <div class="col-md-6">
                                        <label for="tunerRefreshInterval" class="form-label">Tuner Status Refresh Interval (seconds)</label>
                                        <input type="number" class="form-control" id="tunerRefreshInterval"
                                               @bind="Host.TunerRefreshIntervalSeconds" min="0" max="300" />
                                        <div class="form-text">How often to refresh tuner status on the dashboard. Set to 0 to disable auto-refresh.</div>
                                    </div>
                                </div>
                            </div>
                        </section>

                        <section id="physicalTranscoderSettings" class="card">
                            <div class="card-header">
                                <h5 class="mb-0">Transcoder Settings</h5>
                            </div>
                            <div class="card-body">
                                <p class="small text-body-secondary">Each physical device inherits these source-stage settings unless its tab enables an override.</p>
                                <GlobalTranscoderSettings Settings="Host.Topology.PhysicalDefaults"
                                                          IdPrefix="physicalDefault"
                                                          CssPrefix="physical"
                                                          StageName="source-stage"
                                                          HevcHelpText="Normalize HEVC sources once before they enter the multiplexer."
                                                          DeinterlaceHelpText="Default source normalization for physical devices without an override."
                                                          BitrateHelpText="Default physical-stage bitrate for devices without an override."
                                                          SettingsChanged="Host.OnTranscoderSettingsChanged" />
                            </div>
                        </section>
                    </div>
                }
                else
                {
                    var index = Host.Topology.PhysicalDevices.FindIndex(device => device.Id == Host.SelectedPhysicalDeviceId);
                    if (index >= 0)
                    {
                        var device = Host.Topology.PhysicalDevices[index];
                        <div class="physical-device d-grid gap-4" data-device-id="@device.Id" data-device-kind="@device.Kind">
                            <section class="card physical-device-settings">
                                <div class="card-header d-flex justify-content-between align-items-center">
                                    <div>
                                        <h5 class="mb-0">Device Settings</h5>
                                        <div class="small text-body-secondary">@(string.IsNullOrWhiteSpace(device.Name) ? $"{Host.GetPhysicalDeviceTypeName(device)} {index + 1}" : device.Name) - @Host.GetPhysicalDeviceTypeName(device)</div>
                                    </div>
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="form-check form-switch mb-0">
                                            <input id="@($"physicalEnabled-{index}")" class="form-check-input physical-enabled" type="checkbox" @bind="device.Enabled" />
                                            <label class="form-check-label" for="@($"physicalEnabled-{index}")">Enabled</label>
                                        </div>
                                        <button type="button" class="btn btn-sm btn-outline-danger remove-physical-device"
                                                aria-label="Remove physical device" @onclick="() => Host.RemovePhysicalDevice(device.Id)">
                                            <span class="bi bi-trash"></span>
                                        </button>
                                    </div>
                                </div>
                                @if (device.Enabled)
                                {
                                    <div class="card-body physical-device-details">
                                        <div class="row g-3">
                                            <div class="col-md-6">
                                                <label class="form-label" for="@($"physicalName-{index}")">Name</label>
                                                <input id="@($"physicalName-{index}")" class="form-control physical-name"
                                                       @bind="device.Name" @bind:after="Host.NotifySettingsUiChanged" />
                                                <div class="form-text">A local label used for channel ownership, subscriptions, routing, and status displays.</div>
                                            </div>
                                            @if (device.IsHdHomeRun)
                                            {
                                                <div class="col-md-6">
                                                    <label class="form-label" for="@($"physicalAddress-{index}")">Address</label>
                                                    <input id="@($"physicalAddress-{index}")" class="form-control physical-address" @bind="device.Address" @bind:after="() => Host.ClearPhysicalDeviceProbeState(device)" />
                                                    <div class="form-text">Hostname or IP address of the physical HDHomeRun. It must be reachable from the Lineup host or container.</div>
                                                </div>
                                            }
                                            else if (device.IsLineupLink)
                                            {
                                                <div class="col-md-6">
                                                    <label class="form-label" for="@($"linkBaseUrl-{index}")">Remote Lineup URL</label>
                                                    <input id="@($"linkBaseUrl-{index}")" class="form-control" placeholder="https://lineup.example:8443" @bind="device.LinkBaseUrl" @bind:after="() => Host.ClearPhysicalDeviceProbeState(device)" />
                                                    <div class="form-text">Base URL used to request device metadata, channels, tuner status, and streams from the remote Lineup host.</div>
                                                </div>
                                                <div class="col-md-6">
                                                    <label class="form-label" for="@($"linkVirtualDevice-{index}")">Remote virtual device ID</label>
                                                    <input id="@($"linkVirtualDevice-{index}")" class="form-control" @bind="device.LinkVirtualDeviceId" @bind:after="() => Host.ClearPhysicalDeviceProbeState(device)" />
                                                    <div class="form-text">Stable ID of the virtual Lineup Link output exported by the remote host.</div>
                                                </div>
                                                <div class="col-md-6">
                                                    <label class="form-label" for="@($"linkTransport-{index}")">Transport security</label>
                                                    <select id="@($"linkTransport-{index}")" class="form-select" @bind="device.LinkTransportSecurity" @bind:after="() => Host.ClearPhysicalDeviceProbeState(device)">
                                                        <option value="@LineupLinkTransportSecurity.Https">HTTPS</option>
                                                        <option value="@LineupLinkTransportSecurity.Http">HTTP</option>
                                                    </select>
                                                    <div class="form-text">HTTPS encrypts credentials and stream traffic. HTTP should only be used on a trusted private network.</div>
                                                </div>
                                                <div class="col-md-6">
                                                    <label class="form-label" for="@($"linkAccessToken-{index}")">Access token</label>
                                                    <input id="@($"linkAccessToken-{index}")" class="form-control" type="password" autocomplete="off" @bind="device.LinkAccessToken" @bind:after="() => Host.ClearPhysicalDeviceProbeState(device)" />
                                                    <div class="form-text">Bearer token issued by the remote virtual device. Treat it as a password.</div>
                                                </div>
                                                @if (device.LinkTransportSecurity == LineupLinkTransportSecurity.Https)
                                                {
                                                    <div class="col-12">
                                                        <label class="form-label" for="@($"linkCertificate-{index}")">Certificate SHA-256 fingerprint (optional)</label>
                                                        <input id="@($"linkCertificate-{index}")" class="form-control" @bind="device.LinkCertificateSha256" @bind:after="() => Host.ClearPhysicalDeviceProbeState(device)" />
                                                        <div class="form-text">Normal operating-system certificate trust is always required; pinning adds an exact fingerprint check.</div>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="col-12">
                                                        <div class="alert alert-warning mb-0">HTTP authenticates requests but does not encrypt the token or stream. Use it only on a trusted network.</div>
                                                    </div>
                                                }
                                                <div class="col-12">
                                                    <label class="form-label" for="@($"linkImportBundle-{index}")">Connection bundle</label>
                                                    <textarea id="@($"linkImportBundle-{index}")" class="form-control font-monospace" rows="7" @bind="device.LinkConnectionBundle"></textarea>
                                                    <button type="button" class="btn btn-outline-secondary mt-2" @onclick="() => Host.ImportLineupLinkBundle(device)">Import bundle</button>
                                                    <div class="form-text">Paste a bundle exported by the remote virtual device to populate its URL, ID, token, transport, and certificate settings. Bundles contain a usable access token; store and share them as secrets.</div>
                                                </div>
                                            }
                                            <div class="col-12">
                                                @{
                                                    var probeState = Host.GetPhysicalDeviceProbeState(device);
                                                }
                                                @if (Host.SupportsPhysicalDeviceProbe(device))
                                                {
                                                    <button id="@($"testPhysicalDevice-{index}")" type="button" class="btn btn-outline-primary test-physical-device"
                                                            disabled="@(probeState?.IsTesting == true)" @onclick="() => Host.TestAndIdentifyPhysicalDeviceAsync(device)">
                                                        @if (probeState?.IsTesting == true)
                                                        {
                                                            <span class="spinner-border spinner-border-sm me-1"></span>
                                                            <span>Testing...</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="bi bi-plug me-1"></span>
                                                            <span>Test &amp; Identify</span>
                                                        }
                                                    </button>
                                                    <div class="form-text">Tests the current unsaved connection values and reads device identity. It does not save settings, refresh channels, or activate the device.</div>
                                                }
                                                else
                                                {
                                                    <div class="form-text">This physical-device plugin does not provide a connection test.</div>
                                                }

                                                @if (probeState?.Result is { } probeResult)
                                                {
                                                    <div class="alert alert-success mt-3 mb-0 physical-device-probe-success" role="status">
                                                        <div class="fw-semibold mb-2"><span class="bi bi-check-circle me-1"></span>Connection successful</div>
                                                        <dl class="row mb-2">
                                                            @foreach (var detail in probeResult.Details)
                                                            {
                                                                <dt class="col-sm-4">@detail.Label</dt>
                                                                <dd class="col-sm-8">@detail.Value</dd>
                                                            }
                                                        </dl>
                                                        @if (!string.IsNullOrWhiteSpace(probeResult.SuggestedName) &&
                                                             !string.Equals(device.Name.Trim(), probeResult.SuggestedName.Trim(), StringComparison.Ordinal))
                                                        {
                                                            <button type="button" class="btn btn-sm btn-outline-success use-discovered-name"
                                                                    @onclick="() => Host.UseDiscoveredPhysicalDeviceName(device)">
                                                                Use discovered name
                                                            </button>
                                                        }
                                                    </div>
                                                }
                                                else if (!string.IsNullOrWhiteSpace(probeState?.Error))
                                                {
                                                    <div class="alert alert-danger mt-3 mb-0 physical-device-probe-error" role="alert">
                                                        <div class="fw-semibold"><span class="bi bi-x-circle me-1"></span>Connection failed</div>
                                                        <div>@probeState.Error</div>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                            </section>
                            @if (device.Enabled)
                            {
                                <section class="card physical-device-transcoder-settings">
                                    <div class="card-header">
                                        <h5 class="mb-0">Transcoder Settings</h5>
                                    </div>
                                    <div class="card-body">
                                        <DeviceTranscoderSettings Settings="device"
                                                                  Defaults="Host.Topology.PhysicalDefaults"
                                                                  IdPrefix="physical"
                                                                  CssPrefix="physical"
                                                                  Index="index"
                                                                  StageName="source-stage" />
                                    </div>
                                </section>
                            }
                        </div>
                    }
                }
            </div>
        </div>

        @if (Host.ShowPhysicalDeviceTypePickerValue)
        {
            <TypePickerModal Id="physicalDeviceTypePicker"
                             Title="Add Physical Device"
                             Description="Select the type of physical device to add."
                             CloseRequested="() => Host.ShowPhysicalDeviceTypePickerValue = false">
                @foreach (var driver in Host.AvailablePhysicalTunerDrivers)
                {
                    <button type="button" class="list-group-item list-group-item-action physical-device-type"
                            data-physical-device-kind="@driver.Kind" @onclick="() => Host.AddPhysicalDevice(driver)">
                        @driver.DisplayName
                    </button>
                }
            </TypePickerModal>
        }

@using Lineup.Core.Streaming
@using Lineup.LineupLink.Protocol
@using Lineup.Web.Components.Transcoding
