<div id="apiSettingsTab" class="@CssClass" role="tabpanel" aria-labelledby="tab-api">
    <div class="card mb-4 api-documentation-card">
        <div class="card-header">
            <h5 class="mb-0"><span class="bi bi-braces-asterisk me-1"></span>@Text["Settings_ApiDocumentationHeading"]</h5>
        </div>
        <div class="card-body">
            <p>@Text["Settings_ApiDocumentationDescription"]</p>
            <a class="btn btn-outline-primary api-documentation-link"
               href="/api-docs"
               target="_blank"
               rel="noopener noreferrer">
                <span class="bi bi-box-arrow-up-right me-1" aria-hidden="true"></span>@Text["Settings_OpenApiDocumentationButton"]
            </a>
        </div>
    </div>

    <ApiPrivacySettingsPanel RedactClientAddresses="RedactClientAddresses"
                             RedactClientAddressesChanged="RedactClientAddressesChanged"
                             RedactDeviceAddresses="RedactDeviceAddresses"
                             RedactDeviceAddressesChanged="RedactDeviceAddressesChanged"
                             RedactUrls="RedactUrls"
                             RedactUrlsChanged="RedactUrlsChanged" />
</div>

@code {
    /// <summary>Gets or sets the tab visibility class.</summary>
    [Parameter]
    public string CssClass { get; set; } = string.Empty;

    /// <summary>Gets or sets whether client addresses are redacted.</summary>
    [Parameter]
    public bool RedactClientAddresses { get; set; }

    /// <summary>Gets or sets the client-address redaction callback.</summary>
    [Parameter]
    public EventCallback<bool> RedactClientAddressesChanged { get; set; }

    /// <summary>Gets or sets whether device addresses are redacted.</summary>
    [Parameter]
    public bool RedactDeviceAddresses { get; set; }

    /// <summary>Gets or sets the device-address redaction callback.</summary>
    [Parameter]
    public EventCallback<bool> RedactDeviceAddressesChanged { get; set; }

    /// <summary>Gets or sets whether URLs are redacted.</summary>
    [Parameter]
    public bool RedactUrls { get; set; }

    /// <summary>Gets or sets the URL redaction callback.</summary>
    [Parameter]
    public EventCallback<bool> RedactUrlsChanged { get; set; }
}
