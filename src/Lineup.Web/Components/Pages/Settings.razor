@page "/settings"
@rendermode InteractiveServer
@using Lineup.Web.Services

<PageTitle>Settings</PageTitle>

@if (_isRestarting || _isFactoryResetting)
{
    <div id="factoryResetRestartOverlay" class="position-fixed top-0 start-0 w-100 h-100 bg-body d-flex align-items-center justify-content-center p-4" style="z-index: 2000;" role="status" aria-live="assertive">
        <div class="text-center" style="max-width: 32rem;">
            <div id="factoryResetRestartProgress">
                <div class="spinner-border text-primary mb-3" style="width: 3rem; height: 3rem;" aria-hidden="true"></div>
                <h1 class="h3">Restarting Lineup</h1>
                @if (_isFactoryResetting)
                {
                    <p class="text-body-secondary mb-0">Factory reset is complete. Lineup will return to Device setup automatically when it is ready.</p>
                }
                else
                {
                    <p class="text-body-secondary mb-0">Lineup will return to this page automatically when it is ready.</p>
                }
            </div>
            <div id="factoryResetRestartTimeout" class="d-none">
                <span class="bi bi-exclamation-circle text-warning fs-1" aria-hidden="true"></span>
                <h1 class="h3 mt-3">Lineup is taking longer than expected</h1>
                <p class="text-body-secondary">Make sure Lineup is running, then try connecting again.</p>
                <button id="retryFactoryResetRestart" type="button" class="btn btn-primary" onclick="retryLineupFactoryResetWatch()">
                    <span class="bi bi-arrow-clockwise me-1"></span>Retry
                </button>
            </div>
        </div>
    </div>
}

<h1><span class="bi bi-gear me-2"></span>Settings</h1>

@if (_isInitialSetup)
{
    <div class="alert alert-primary mb-4">
        <h5 class="alert-heading"><span class="bi bi-rocket-takeoff me-2"></span>Welcome to Lineup!</h5>
        <p class="mb-0">Configure your HDHomeRun device address and preferences below, then click <strong>Save Settings</strong> to get started.</p>
    </div>
}

<ul class="nav nav-tabs mb-4" role="tablist" aria-label="Settings categories">
    <li class="nav-item" role="presentation">
        <button id="tab-general" type="button" class="@GetTabButtonClass(SettingsTab.General)" role="tab"
                aria-selected="@(_activeTab == SettingsTab.General)" @onclick="() => SelectTab(SettingsTab.General)">
            <span class="bi bi-sliders me-1"></span>General
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button id="tab-guide" type="button" class="@GetTabButtonClass(SettingsTab.Guide)" role="tab"
                aria-selected="@(_activeTab == SettingsTab.Guide)" @onclick="() => SelectTab(SettingsTab.Guide)">
            <span class="bi bi-calendar3 me-1"></span>Guide &amp; XMLTV
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button id="tab-device" type="button" class="@GetTabButtonClass(SettingsTab.Device)" role="tab"
                aria-selected="@(_activeTab == SettingsTab.Device)" @onclick="() => SelectTab(SettingsTab.Device)">
            <span class="bi bi-hdd-network me-1"></span>Device
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button id="tab-transcoding" type="button" class="@GetTabButtonClass(SettingsTab.Transcoding)" role="tab"
                aria-selected="@(_activeTab == SettingsTab.Transcoding)" @onclick="() => SelectTab(SettingsTab.Transcoding)">
            <span class="bi bi-film me-1"></span>Transcoding
        </button>
    </li>
    @if (!_isInitialSetup)
    {
        <li class="nav-item" role="presentation">
            <button id="tab-api" type="button" class="@GetTabButtonClass(SettingsTab.Api)" role="tab"
                    aria-selected="@(_activeTab == SettingsTab.Api)" @onclick="() => SelectTab(SettingsTab.Api)">
                <span class="bi bi-braces me-1"></span>API
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button id="tab-logging" type="button" class="@GetTabButtonClass(SettingsTab.Logging)" role="tab"
                    aria-selected="@(_activeTab == SettingsTab.Logging)" @onclick="() => SelectTab(SettingsTab.Logging)">
                <span class="bi bi-journal-text me-1"></span>Logging
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button id="tab-reset" type="button" class="@GetTabButtonClass(SettingsTab.Reset)" role="tab"
                    aria-selected="@(_activeTab == SettingsTab.Reset)" @onclick="() => SelectTab(SettingsTab.Reset)">
                <span class="bi bi-arrow-counterclockwise me-1"></span>Reset
            </button>
        </li>
    }
</ul>

<div id="settingsContent" class="row">
    <div class="col-md-8">
        <div id="generalSettingsTab" class="@GetTabPaneClass(SettingsTab.General)" role="tabpanel" aria-labelledby="tab-general">
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">Appearance</h5>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label">Theme</label>
                    <div class="btn-group d-flex" role="group">
                        <input type="radio" class="btn-check" name="theme" id="themeLight" value="light" checked="@(_theme == "light")" @onchange='() => _theme = "light"' />
                        <label class="btn btn-outline-secondary" for="themeLight">
                            <span class="bi bi-sun-fill me-1"></span>Light
                        </label>
                        <input type="radio" class="btn-check" name="theme" id="themeDark" value="dark" checked="@(_theme == "dark")" @onchange='() => _theme = "dark"' />
                        <label class="btn btn-outline-secondary" for="themeDark">
                            <span class="bi bi-moon-stars-fill me-1"></span>Dark
                        </label>
                        <input type="radio" class="btn-check" name="theme" id="themeAuto" value="auto" checked="@(_theme == "auto")" @onchange='() => _theme = "auto"' />
                        <label class="btn btn-outline-secondary" for="themeAuto">
                            <span class="bi bi-circle-half me-1"></span>Auto
                        </label>
                    </div>
                    <div class="form-text">Choose Light, Dark, or Auto to follow your system preference.</div>
                </div>
                
                <div class="mb-3">
                    <label for="timeZone" class="form-label">Time Zone</label>
                    <select class="form-select" id="timeZone" @bind="_timeZoneId">
                        <option value="">System default</option>
                        @foreach (var tz in TimeZoneInfo.GetSystemTimeZones())
                        {
                            <option value="@tz.Id">@tz.DisplayName</option>
                        }
                    </select>
                    <div class="form-text">
                        Override the display timezone. "System default" uses the <code>TZ</code> environment variable or the server's local time.
                        Currently: <strong>@TimeZoneService.TimeZone.DisplayName</strong>
                    </div>
                </div>
            </div>


        </div>
        </div>

        <div id="guideSettingsTab" class="@GetTabPaneClass(SettingsTab.Guide)" role="tabpanel" aria-labelledby="tab-guide">
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">EPG Fetch Settings</h5>
            </div>
            <div class="card-body">
                <div class="form-check">
                    <input type="checkbox" class="form-check-input" id="autoFetchEnabled" @bind="_autoFetchEnabled" />
                    <label class="form-check-label" for="autoFetchEnabled">Automatically refresh guide data</label>
                    <div class="form-text">
                        Downloads SiliconDust's complete guide at a randomized interval between 20 and 28 hours, as required by the API.
                        Availability is 2 days for everyone or 14 days with an HDHomeRun DVR guide subscription.
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">XMLTV Output Settings</h5>
            </div>
            <div class="card-body">
                <div class="mb-3 form-check">
                    <input type="checkbox" class="form-check-input" id="autoGenerateXmltv" 
                           @bind="_autoGenerateXmltv" />
                    <label class="form-check-label" for="autoGenerateXmltv">Publish XMLTV after fetch</label>
                    <div class="form-text">Atomically publishes the canonical SiliconDust XMLTV document when a refresh completes.</div>
                </div>
                
                <div class="mb-3">
                    <label for="xmltvOutputPath" class="form-label">XMLTV Output Destination</label>
                    <div class="input-group">
                        <input type="text" class="form-control" id="xmltvOutputPath" @bind="_xmltvOutputPath" placeholder="/xmltv/epg.xml" />
                        <button id="browseXmltvDirectories" class="btn btn-outline-secondary" type="button" @onclick="BrowseDirectory" title="Browse server directories">
                            <span class="bi bi-folder2-open"></span>
                        </button>
                    </div>
                    <div class="form-text">
                        Path where Lineup publishes and serves XMLTV. It can be relative or absolute. <code>Lineup:XmltvPath</code> supplies the initial and reset value.
                    </div>
                    @if (XmltvOutputPathDiffersFromConfigured())
                    {
                        <div id="xmltvPathMismatch" class="alert alert-info mt-2 mb-0">
                            <div>The saved path differs from the startup-configured value: <code>@SettingsService.ConfiguredXmltvOutputPath</code></div>
                            <button id="resetXmltvOutputPath" type="button" class="btn btn-sm btn-outline-primary mt-2" @onclick="ResetXmltvOutputPath">
                                Reset to configured path
                            </button>
                        </div>
                    }
                </div>

                @if (_showDirectoryBrowser)
                {
                    <div id="xmltvDirectoryBrowser" class="card mb-3">
                        <div class="card-header d-flex justify-content-between align-items-center py-2">
                            <span><span class="bi bi-folder me-1"></span>Server Directory Browser</span>
                            <button id="closeXmltvDirectoryBrowser" type="button" class="btn-close" @onclick="CloseDirectoryBrowser"></button>
                        </div>
                        <div class="card-body py-2">
                            <div class="input-group input-group-sm mb-2">
                                <span class="input-group-text"><span class="bi bi-folder-fill"></span></span>
                                <input id="currentXmltvDirectory" type="text" class="form-control" value="@_currentDirectory" readonly />
                                <button id="navigateUpXmltvDirectory" class="btn btn-outline-secondary" type="button" @onclick="NavigateUp" disabled="@(!CanNavigateUp)" title="Parent directory">
                                    <span class="bi bi-arrow-up"></span>
                                </button>
                            </div>
                            <div style="max-height: 200px; overflow-y: auto;">
                                @if (_directoryError != null)
                                {
                                    <div id="xmltvDirectoryError" class="alert alert-danger py-1 mb-0 small">@_directoryError</div>
                                }
                                else
                                {
                                    <ul class="list-group list-group-flush">
                                        @foreach (var directory in _directories)
                                        {
                                            <li class="list-group-item list-group-item-action py-1 small xmltv-directory" @onclick="() => NavigateToDirectory(directory)" style="cursor: pointer;">
                                                <span class="bi bi-folder me-1 text-warning"></span>@Path.GetFileName(directory)
                                            </li>
                                        }
                                    </ul>
                                }
                            </div>
                            <div class="input-group input-group-sm mt-2">
                                <span class="input-group-text">Filename:</span>
                                <input id="xmltvFilename" type="text" class="form-control" @bind="_selectedFilename" placeholder="epg.xml" />
                                <button id="selectXmltvPath" class="btn btn-primary" type="button" @onclick="SelectXmltvPath">
                                    <span class="bi bi-check me-1"></span>Select
                                </button>
                            </div>
                        </div>
                    </div>
                }

                @if (ResolvedXmltvOutputPath is string resolvedXmltvOutputPath)
                {
                    <div id="resolvedXmltvOutputPath" class="alert alert-info py-2 mb-0 small">
                        <span class="bi bi-info-circle me-1"></span><strong>Resolved path:</strong> <code>@resolvedXmltvOutputPath</code>
                    </div>
                }
            </div>
        </div>
        </div>

        <div id="deviceSettingsTab" class="@GetTabPaneClass(SettingsTab.Device)" role="tabpanel" aria-labelledby="tab-device">
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">Device Settings</h5>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label for="deviceAddress" class="form-label">HDHomeRun Device Address</label>
                    <input type="text" class="form-control" id="deviceAddress" 
                           @bind="_deviceAddress" />
                    <div class="form-text">Hostname or IP address of your HDHomeRun device.</div>
                </div>
                
                <div class="mb-3">
                    <label for="deviceRefreshInterval" class="form-label">Device Info Refresh Interval (minutes)</label>
                    <input type="number" class="form-control" id="deviceRefreshInterval" 
                           @bind="_deviceRefreshIntervalMinutes" min="0" max="60" />
                    <div class="form-text">How often to refresh device information. Set to 0 to disable auto-refresh.</div>
                </div>
                
                <div class="mb-3">
                    <label for="tunerRefreshInterval" class="form-label">Tuner Status Refresh Interval (seconds)</label>
                    <input type="number" class="form-control" id="tunerRefreshInterval" 
                           @bind="_tunerRefreshIntervalSeconds" min="0" max="300" />
                    <div class="form-text">How often to refresh tuner status on the dashboard. Set to 0 to disable auto-refresh.</div>
                </div>

                <div class="mb-3">
                    <label for="activeStreamRefreshInterval" class="form-label">Active Stream Refresh Interval (seconds)</label>
                    <input type="number" class="form-control" id="activeStreamRefreshInterval"
                           @bind="_activeStreamRefreshIntervalSeconds" min="0" max="300" />
                    <div class="form-text">How often to refresh active hosted streams on the dashboard. Set to 0 to disable auto-refresh.</div>
                </div>
            </div>
        </div>

        <div id="hdHomeRunProxySettings" class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">HDHomeRun Proxy</h5>
                </div>
                <div class="card-body">
                    <div class="form-check form-switch">
                        <input id="enableHdHomeRunProxy" class="form-check-input" type="checkbox" @bind="_enableHdHomeRunProxy" />
                        <label class="form-check-label" for="enableHdHomeRunProxy">Enable HDHomeRun Proxy</label>
                    </div>

                    @if (_enableHdHomeRunProxy)
                    {
                    <div id="hdHomeRunProxyConfiguration" class="mt-3">
                    <div class="form-check form-switch mb-3">
                        <input id="enableNetworkDiscovery" class="form-check-input" type="checkbox" @bind="_enableNetworkDiscovery" />
                        <label class="form-check-label" for="enableNetworkDiscovery">Enable UDP and SSDP network discovery</label>
                        <div class="form-text">
                            Opt in to SiliconDust UDP discovery on port 65001 and SSDP on port 1900. Every enabled profile needs an advertised URL.
                        </div>
                    </div>

                    @for (var index = 0; index < _proxyProfiles.Count; index++)
                    {
                        var profile = _proxyProfiles[index];
                        var profileIndex = index;
                        <div class="proxy-profile border rounded p-3 mb-3" data-profile-index="@profileIndex">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h6 class="mb-0">@(profileIndex == 0 ? "Primary / legacy profile" : $"Additional profile {profileIndex + 1}")</h6>
                                @if (profileIndex > 0)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-danger remove-proxy-profile"
                                            aria-label="Remove proxy profile" @onclick="() => RemoveProxyProfile(profileIndex)">
                                        <span class="bi bi-trash"></span>
                                    </button>
                                }
                            </div>
                            @if (profileIndex > 0)
                            {
                                <div class="form-check mb-3">
                                    <input id="@($"proxyEnabled-{profileIndex}")" class="form-check-input proxy-enabled" type="checkbox"
                                           @bind="profile.Enabled" />
                                    <label class="form-check-label" for="@($"proxyEnabled-{profileIndex}")">Enabled</label>
                                </div>
                            }
                            <div class="row g-3">
                                @if (profileIndex == 0)
                                {
                                    <div class="col-12">
                                        <div class="form-text">
                                            Uses the HDHomeRun Device Address above so the existing Dashboard and EPG configuration remain compatible.
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="col-md-6">
                                        <label for="@($"proxyAddress-{profileIndex}")" class="form-label">Physical address</label>
                                        <input id="@($"proxyAddress-{profileIndex}")" class="form-control proxy-address" type="text"
                                               @bind="profile.PhysicalAddress" placeholder="192.0.2.20" />
                                    </div>
                                }
                                <div class="col-md-6">
                                    <label for="@($"proxyName-{profileIndex}")" class="form-label">Friendly name</label>
                                    <input id="@($"proxyName-{profileIndex}")" class="form-control proxy-name" type="text"
                                           @bind="profile.FriendlyName" placeholder="Optional" />
                                </div>
                                <div class="col-md-6">
                                    <label for="@($"proxyDeviceId-{profileIndex}")" class="form-label">Virtual DeviceID</label>
                                    <input id="@($"proxyDeviceId-{profileIndex}")" class="form-control proxy-device-id" type="text"
                                           value="@profile.VirtualDeviceId" readonly />
                                    <div class="form-text">Generated once and retained when the physical address changes.</div>
                                </div>
                                <div class="col-md-6">
                                    <label for="@($"proxyTunerCap-{profileIndex}")" class="form-label">Tuner-count cap</label>
                                    <input id="@($"proxyTunerCap-{profileIndex}")" class="form-control proxy-tuner-cap" type="number"
                                           @bind="profile.TunerCountCap" min="1" max="255" placeholder="Physical tuner count" />
                                </div>
                                <div class="col-12">
                                    <label for="@($"proxyAdvertisedUrl-{profileIndex}")" class="form-label">Advertised base URL</label>
                                    <input id="@($"proxyAdvertisedUrl-{profileIndex}")" class="form-control proxy-advertised-url" type="url"
                                           @bind="profile.AdvertisedBaseUrl" placeholder="http://192.0.2.5:8080/" />
                                    <div class="form-text">An externally reachable Lineup root URL. Never infer this from container or request addresses.</div>
                                </div>
                            </div>

                            @if (profile.Enabled)
                            {
                                <div class="profile-setup-urls mt-3">
                                    <div class="small fw-semibold mb-1">Manual setup URLs</div>
                                    @foreach (var endpoint in new[] { ("Discovery", "discover.json"), ("Lineup", "lineup.json"), ("Device XML", "device.xml") })
                                    {
                                        var setupUrl = GetProfileSetupUrl(profile, profileIndex, endpoint.Item2);
                                        <div class="input-group input-group-sm mb-1">
                                            <span class="input-group-text">@endpoint.Item1</span>
                                            <input class="form-control setup-url" value="@setupUrl" readonly />
                                            <button type="button" class="btn btn-outline-secondary copy-setup-url"
                                                    title="Copy URL" @onclick="() => CopyUrl(setupUrl)">
                                                <span class="bi bi-clipboard"></span>
                                            </button>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }

                    <div class="alert alert-warning small">
                        Jellyfin identifies auto-discovered devices by advertised network address. Multiple profiles generally require distinct advertised IP
                        addresses or manual tuner setup. Docker bridge networking often blocks UDP broadcast and multicast; use host networking where supported,
                        or configure each tuner manually with the URLs above.
                    </div>
                    <div class="d-flex justify-content-end">
                        <button id="addProxyProfile" type="button" class="btn btn-sm btn-outline-primary" @onclick="AddProxyProfile">
                            <span class="bi bi-plus-lg me-1"></span>Add device
                        </button>
                    </div>
                    </div>
                    }
                </div>
            </div>
        </div>

        <div id="transcodingSettingsTab" class="@GetTabPaneClass(SettingsTab.Transcoding)" role="tabpanel" aria-labelledby="tab-transcoding">
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">General</h5>
            </div>
            <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="maximumVideoBitRate" class="form-label">Maximum Video Bitrate</label>
                            <div class="input-group">
                                <input type="number" class="form-control" id="maximumVideoBitRate"
                                       @bind="_maximumVideoBitRateMbps" min="2" max="30" />
                                <span class="input-group-text">Mbps</span>
                            </div>
                            <div class="form-text">Global ceiling for transcoded video. Recommended for 1080p: 10 Mbps.</div>
                        </div>
                        <div class="col-md-6">
                            <label for="maximumConcurrentStreams" class="form-label">Maximum Concurrent Streams</label>
                            <input type="number" class="form-control" id="maximumConcurrentStreams"
                                   @bind="_maximumConcurrentStreams" min="0" max="100" />
                            <div class="form-text">Maximum hosted streams across all formats. Set to 0 for unlimited.</div>
                        </div>
                        <div class="col-md-6">
                            <label for="audioTranscodeMode" class="form-label">Virtual Tuner Audio</label>
                            <select class="form-select" id="audioTranscodeMode" @bind="_audioTranscodeMode">
                                <option value="@AudioTranscodeMode.Copy">Preserve non-AC-4 audio codecs</option>
                                <option value="@AudioTranscodeMode.Ac3">Transcode non-AC-4 audio to AC-3</option>
                                <option value="@AudioTranscodeMode.Eac3">Transcode non-AC-4 audio to E-AC-3</option>
                            </select>
                            <div class="form-text">Preserve or transcode non-AC-4 tracks in the transparent MPEG-TS proxy.</div>
                        </div>
                        <div class="col-md-6">
                            <label for="ac4TranscodeTarget" class="form-label">AC-4 Audio</label>
                            <select class="form-select" id="ac4TranscodeTarget" @bind="_ac4TranscodeTarget">
                                <option value="@Ac4TranscodeTarget.Preserve">Preserve AC-4 codec</option>
                                <option value="@Ac4TranscodeTarget.Ac3">Transcode AC-4 to AC-3</option>
                                <option value="@Ac4TranscodeTarget.Eac3">Transcode AC-4 to E-AC-3</option>
                            </select>
                            <div class="form-text">Preserve AC-4 for compatible receivers, or transcode it for broader client support. AC-3 remains the default.</div>
                        </div>
                        <div class="col-md-6">
                            <label for="virtualTunerVideoMode" class="form-label">Virtual Tuner Video</label>
                            <select class="form-select" id="virtualTunerVideoMode" @bind="_virtualTunerVideoMode">
                                <option value="@VirtualTunerVideoMode.Preserve">Preserve video codec</option>
                                <option value="@VirtualTunerVideoMode.ConvertHevcToH264">Transcode HEVC to H.264</option>
                            </select>
                            <div class="form-text">
                                Preserve HEVC for Plex and Jellyfin to handle directly. Transcode only when a server or playback client cannot process HEVC Live TV.
                            </div>
                        </div>
                        <div class="col-12">
                            <label for="protectedContentMode" class="form-label">DRM-Protected Content</label>
                            <select class="form-select" id="protectedContentMode" @bind="_protectedContentMode">
                                <option value="@ProtectedContentMode.ReturnError">Return a protected-content error</option>
                                <option value="@ProtectedContentMode.StreamSlate">Stream a Content Protected slate</option>
                            </select>
                            <div class="form-text">Return an error or a synthetic compatibility slate. Protected programming is never decrypted.</div>
                        </div>
                    </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">Web Player</h5>
            </div>
            <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label for="webVideoPreset" class="form-label">Video Preset</label>
                            <select class="form-select" id="webVideoPreset" @bind="_webVideoPreset">
                                <option value="@WebVideoPreset.VeryFast">Very fast (recommended)</option>
                                <option value="@WebVideoPreset.Faster">Faster</option>
                                <option value="@WebVideoPreset.Fast">Fast</option>
                                <option value="@WebVideoPreset.Medium">Medium</option>
                            </select>
                            <div class="form-text">Slower presets reduce artifacts but require more CPU.</div>
                        </div>
                        <div class="col-md-6">
                            <label for="webVideoQuality" class="form-label">Video Quality (CRF)</label>
                            <input type="number" class="form-control" id="webVideoQuality" @bind="_webVideoQuality" min="16" max="30" />
                            <div class="form-text">Lower is higher quality. Recommended: 21.</div>
                        </div>
                    </div>
            </div>
        </div>
        </div>

        @if (!_isInitialSetup)
        {
            <div id="apiSettingsTab" class="@GetTabPaneClass(SettingsTab.Api)" role="tabpanel" aria-labelledby="tab-api">
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0"><span class="bi bi-shield-check me-1"></span>Status API Privacy</h5>
                    </div>
                    <div class="card-body">
                        <p>
                            External dashboards can read the current Lineup state from
                            <a href="/api/v1/status" target="_blank" rel="noopener"><code>/api/v1/status</code></a>.
                            This read-only endpoint is unauthenticated and should be exposed only to trusted networks.
                        </p>
                        <div class="form-check form-switch mb-3">
                            <input id="redactApiClientAddresses" class="form-check-input" type="checkbox" role="switch"
                                   @bind="_redactApiClientAddresses" />
                            <label class="form-check-label" for="redactApiClientAddresses">Redact active-stream client addresses</label>
                            <div class="form-text">Returns each stream's client address as <code>null</code>.</div>
                        </div>
                        <div class="form-check form-switch mb-3">
                            <input id="redactApiDeviceAddresses" class="form-check-input" type="checkbox" role="switch"
                                   @bind="_redactApiDeviceAddresses" />
                            <label class="form-check-label" for="redactApiDeviceAddresses">Redact device addresses</label>
                            <div class="form-text">Returns configured physical tuner hostnames and addresses as <code>null</code>.</div>
                        </div>
                        <div class="form-check form-switch">
                            <input id="redactApiUrls" class="form-check-input" type="checkbox" role="switch"
                                   @bind="_redactApiUrls" />
                            <label class="form-check-label" for="redactApiUrls">Redact URLs</label>
                            <div class="form-text">Returns device, lineup, tuner target, advertised, and XMLTV URLs as <code>null</code>.</div>
                        </div>
                    </div>
                </div>
            </div>

            <div id="loggingSettingsTab" class="@GetTabPaneClass(SettingsTab.Logging)" role="tabpanel" aria-labelledby="tab-logging">
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0"><span class="bi bi-funnel me-1"></span>Application Log Filters</h5>
                    </div>
                    <div class="card-body">
                        <div class="form-check form-switch mb-3">
                            <input id="overrideLoggingDefaults" class="form-check-input" type="checkbox" role="switch" @bind="_overrideLoggingDefaults" />
                            <label class="form-check-label" for="overrideLoggingDefaults">Override logging defaults</label>
                        </div>
                        @if (_overrideLoggingDefaults)
                        {
                            <div id="applicationLogFilterOverrides">
                                <div class="mb-3">
                                    <label for="applicationLogLevel" class="form-label">Default Level</label>
                                    <select id="applicationLogLevel" class="form-select" @bind="_applicationLogLevel">
                                        @foreach (var level in ApplicationLogLevels)
                                        {
                                            <option value="@level">@level</option>
                                        }
                                    </select>
                                    <div class="form-text">Applies to categories without a more specific rule.</div>
                                </div>
                                <div class="d-flex justify-content-between align-items-center gap-2 mb-2">
                                    <h6 class="mb-0">Category Overrides</h6>
                                    <button id="addLogCategoryOverride" type="button" class="btn btn-sm btn-outline-primary" @onclick="AddLogCategoryOverride">
                                        <span class="bi bi-plus-lg me-1"></span>Add Category
                                    </button>
                                </div>
                                @if (_logCategoryOverrides.Count == 0)
                                {
                                    <p id="emptyLogCategoryOverrides" class="text-body-secondary mb-0">No category-specific filters are configured.</p>
                                }
                                else
                                {
                                    <div class="vstack gap-2">
                                        @for (var index = 0; index < _logCategoryOverrides.Count; index++)
                                        {
                                            var rowIndex = index;
                                            var category = _logCategoryOverrides[rowIndex];
                                            var isStartupCategory = IsStartupLogCategory(category.Category);
                                            <div class="row g-2 align-items-center log-category-override">
                                                <div class="col-md-7">
                                                    <input class="form-control log-category-prefix"
                                                           aria-label="Category prefix"
                                                           placeholder="Example.Namespace"
                                                           @bind="category.Category"
                                                           disabled="@isStartupCategory" />
                                                </div>
                                                <div class="col-md-4">
                                                    <select class="form-select log-category-level" aria-label="Category minimum level" @bind="category.Level">
                                                        @foreach (var level in ApplicationLogLevels)
                                                        {
                                                            <option value="@level">@level</option>
                                                        }
                                                    </select>
                                                </div>
                                                <div class="col-md-1 d-flex justify-content-end">
                                                    @if (isStartupCategory)
                                                    {
                                                        <span class="badge text-bg-secondary">Startup</span>
                                                    }
                                                    else
                                                    {
                                                        <button type="button"
                                                                class="btn btn-sm btn-outline-danger remove-log-category"
                                                                aria-label="Remove category"
                                                                @onclick="() => RemoveLogCategoryOverride(rowIndex)">
                                                            <span class="bi bi-trash"></span>
                                                        </button>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                                <div class="form-text mt-3">
                                    Startup categories are discovered from <code>Logging:LogLevel</code>. Exact categories and dotted descendants match, with the longest prefix taking precedence.
                                    Changes apply immediately when settings are saved. Turning this override off restores the complete startup filter set.
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0"><span class="bi bi-file-earmark-text me-1"></span>Rolling File Logs</h5>
                    </div>
                    <div class="card-body">
                        <div class="form-check form-switch mb-3">
                            <input id="enableFileLogging" class="form-check-input" type="checkbox" role="switch" @bind="_enableFileLogging" />
                            <label class="form-check-label" for="enableFileLogging">Write logs to rolling files</label>
                        </div>
                        @if (_enableFileLogging)
                        {
                            <div id="rollingFileLogOptions">
                                <div class="row g-3">
                                    <div class="col-md-4">
                                        <label for="fileLogLevel" class="form-label">Minimum Level</label>
                                        <select id="fileLogLevel" class="form-select" @bind="_fileLogLevel">
                                            <option value="Debug">Debug</option>
                                            <option value="Information">Information</option>
                                            <option value="Warning">Warning</option>
                                            <option value="Error">Error</option>
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <label for="fileLogRetentionDays" class="form-label">Retention (days)</label>
                                        <input id="fileLogRetentionDays"
                                               class="form-control"
                                               type="number"
                                               min="1"
                                               max="90"
                                               @bind="_fileLogRetentionDays" />
                                    </div>
                                    <div class="col-md-4">
                                        <label for="fileLogSizeLimitMb" class="form-label">File Size (MB)</label>
                                        <input id="fileLogSizeLimitMb"
                                               class="form-control"
                                               type="number"
                                               min="1"
                                               max="500"
                                               @bind="_fileLogSizeLimitMb" />
                                    </div>
                                </div>
                                <div class="form-text mt-3">
                                    Files are stored in <code>@(LoggingRuntime?.LogDirectory ?? "the Lineup configuration directory/logs")</code>.
                                    Changes take effect immediately when settings are saved.
                                </div>
                            </div>
                        }
                        @if (_enableFileLogging || _retainedLogFiles.Count > 0)
                        {
                            <div id="retainedLogFileManagement">
                                @if (_enableFileLogging)
                                {
                                    <hr />
                                }
                                <h6>Retained Log Files</h6>
                                @if (_retainedLogFiles.Count == 0)
                                {
                                    <p id="emptyRetainedLogFiles" class="text-body-secondary">No rolling log files are available yet.</p>
                                }
                                else
                                {
                                    <div id="retainedLogFiles" class="list-group mb-3">
                                        @foreach (var file in _retainedLogFiles)
                                        {
                                            <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center gap-3"
                                               href="@($"/api/logs/files/{Uri.EscapeDataString(file.Name)}")"
                                               download="@file.Name">
                                                <span><span class="bi bi-download me-2"></span>@file.Name</span>
                                                <small class="text-body-secondary text-end">
                                                    @FormatFileSize(file.Size) · @file.LastModifiedUtc.ToLocalTime().ToString("g")
                                                </small>
                                            </a>
                                        }
                                    </div>
                                }
                                <button id="deleteFileLogs" type="button" class="btn btn-outline-danger" @onclick="DeleteLogs" disabled="@_isDeletingLogs">
                                    <span class="bi bi-trash3 me-1"></span>Delete Logs
                                </button>
                                <div class="form-text">
                                    @if (_enableFileLogging)
                                    {
                                        <span>Deletes all rolling file logs and immediately starts a new empty log file.</span>
                                    }
                                    else
                                    {
                                        <span>Deletes all retained rolling log files.</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0"><span class="bi bi-cloud-arrow-up me-1"></span>External Targets</h5>
                    </div>
                    <div class="card-body">
                        <p>External targets are configured at startup through environment variables or <code>appsettings.json</code>. Secrets are never stored in Lineup settings or displayed here.</p>
                        @if (LoggingRuntime == null)
                        {
                            <p class="text-body-secondary mb-0">Target status is unavailable.</p>
                        }
                        else
                        {
                            <div class="list-group">
                                @foreach (var target in LoggingRuntime.ExternalTargets)
                                {
                                    <div class="list-group-item d-flex justify-content-between align-items-start gap-3">
                                        <div>
                                            <strong>@target.Name</strong>
                                            <div class="small text-body-secondary">@target.Message</div>
                                        </div>
                                        <span class="badge @GetLoggingStatusBadge(target.Status)">@target.Status</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div id="resetSettingsTab" class="@GetTabPaneClass(SettingsTab.Reset)" role="tabpanel" aria-labelledby="tab-reset">
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0"><span class="bi bi-sliders me-1"></span>Reset Settings to Defaults</h5>
                    </div>
                    <div class="card-body">
                        <p>Restores every configurable setting to its default value. You can review the defaults before saving them.</p>
                        <button id="resetSettings" type="button" class="btn btn-outline-secondary" @onclick="ResetToDefaults">
                            <span class="bi bi-arrow-counterclockwise me-1"></span>Reset Settings to Defaults
                        </button>
                    </div>
                </div>

                <div id="restartLineupCard" class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0"><span class="bi bi-arrow-repeat me-1"></span>Restart Lineup</h5>
                    </div>
                    <div class="card-body">
                        <p>Gracefully restarts Lineup without changing settings or deleting application data.</p>
                        <button id="restartLineup" type="button" class="btn btn-outline-primary" @onclick="RestartLineup" disabled="@_isRestarting">
                            <span class="bi bi-arrow-repeat me-1"></span>Restart Lineup
                        </button>
                    </div>
                </div>

                <div id="factoryResetCard" class="card border-danger mb-4">
                    <div class="card-header text-bg-danger">
                        <h5 class="mb-0"><span class="bi bi-exclamation-triangle me-1"></span>Factory Reset</h5>
                    </div>
                    <div class="card-body">
                        <p>
                            Permanently removes Lineup settings, guide database, cached XMLTV data, and transient stream files. Lineup will restart at the first-run Device setup.
                            XMLTV files outside Lineup-owned storage are preserved.
                        </p>
                        @if (!_showFactoryResetConfirmation)
                        {
                            <button id="showFactoryResetConfirmation" type="button" class="btn btn-outline-danger" @onclick="ShowFactoryResetConfirmation">
                                <span class="bi bi-trash3 me-1"></span>Factory Reset Lineup
                            </button>
                        }
                        else
                        {
                            <div id="factoryResetConfirmation" class="alert alert-danger mb-0">
                                <label for="factoryResetConfirmationText" class="form-label">
                                    Type <strong>RESET</strong> to permanently erase all Lineup-owned data.
                                </label>
                                <input id="factoryResetConfirmationText" type="text" class="form-control mb-3" autocomplete="off" @bind="_factoryResetConfirmation" @bind:event="oninput" disabled="@_isFactoryResetting" />
                                <div class="d-flex gap-2">
                                    <button id="confirmFactoryReset" type="button" class="btn btn-danger" @onclick="FactoryReset" disabled="@(!CanFactoryReset || _isFactoryResetting)">
                                        @if (_isFactoryResetting)
                                        {
                                            <span class="spinner-border spinner-border-sm me-1"></span>
                                        }
                                        <span class="bi bi-trash3 me-1"></span>Erase Data and Restart
                                    </button>
                                    <button id="cancelFactoryReset" type="button" class="btn btn-outline-secondary" @onclick="CancelFactoryReset" disabled="@_isFactoryResetting">Cancel</button>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        @if (_activeTab != SettingsTab.Reset)
        {
            <div class="d-flex gap-2">
                <button class="btn btn-primary" @onclick="SaveSettings" disabled="@_isSaving">
                    @if (_isSaving)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                    }
                    <span class="bi bi-save me-1"></span>@(_isInitialSetup ? "Save & Get Started" : "Save Settings")
                </button>
                @if (!_isInitialSetup)
                {
                    <button id="undoSettings" class="btn btn-outline-secondary" @onclick="UndoUnsavedChanges">
                        <span class="bi bi-arrow-counterclockwise me-1"></span>Undo
                    </button>
                }
                <button class="btn btn-outline-secondary" @onclick="Cancel">
                    @(_isInitialSetup ? "Skip" : "Cancel")
                </button>
            </div>
        }

        @if (!string.IsNullOrEmpty(_statusMessage))
        {
            <div class="alert @(_isError ? "alert-danger" : "alert-success") mt-3 alert-dismissible fade show">
                @_statusMessage
                <button type="button" class="btn-close" @onclick="ClearStatus"></button>
            </div>
        }
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0"><span class="bi bi-info-circle me-1"></span>About Settings</h5>
            </div>
            <div class="card-body">
                @if (_activeTab == SettingsTab.General)
                {
                <h6>Appearance</h6>
                <p><strong>Theme:</strong> Choose between Light, Dark, or Auto (follows your system/OS theme). Changes apply immediately.</p>
                <p><strong>Time Zone:</strong> Override the timezone used for all displayed times. "System default" uses the <code>TZ</code> environment variable or UTC in Docker.</p>
                }
                else if (_activeTab == SettingsTab.Guide)
                {
                <h6>EPG Fetch</h6>
                <p><strong>Automatic refresh:</strong> Downloads one complete guide at a randomized 20-28 hour interval. SiliconDust provides 2 days for everyone or 14 days with a DVR subscription.</p>
                <hr />
                <h6>XMLTV Output</h6>
                <p><strong>Publish XMLTV:</strong> When enabled, the canonical SiliconDust document is copied atomically to the configured output after each refresh.</p>
                <p><strong>XMLTV Output Destination:</strong> The saved setting controls the output. <code>Lineup:XmltvPath</code> provides its first-run and reset value.</p>
                }
                else if (_activeTab == SettingsTab.Device)
                {
                <h6>Device</h6>
                <p><strong>Device Address:</strong> The network address of your HDHomeRun device.</p>
                <p><strong>Device Info Refresh:</strong> How often to refresh device information (model, firmware, etc.). Set to 0 to disable. Recommended: 10 minutes.</p>
                <p><strong>Tuner Status Refresh:</strong> How often to refresh tuner status (signal strength, active streams). Set to 0 to disable. Recommended: 30 seconds.</p>
                <p><strong>Active Stream Refresh:</strong> How often the Dashboard refreshes hosted stream details. Set to 0 to use manual refresh only. Default: 5 seconds.</p>
                <hr />
                <h6>HDHomeRun Proxy</h6>
                <p>Each enabled profile exposes one physical tuner as an isolated virtual HDHomeRun. The primary profile keeps the legacy root URLs.</p>
                <p>Network discovery is optional. Use an explicit URL reachable by Jellyfin or other clients; container request addresses are not advertised.</p>
                }
                else if (_activeTab == SettingsTab.Transcoding)
                {
                <h6>Transcode</h6>
                <p><strong>Maximum Video Bitrate:</strong> Caps transcoded video across hosted formats. The 10 Mbps default is suitable for high-motion 1080p video.</p>
                <p><strong>Maximum Concurrent Streams:</strong> Limits active hosted streams across all formats. Set to 0 for unlimited.</p>
                <p><strong>DRM-Protected Content:</strong> Return an error or stream a synthetic compatibility slate.</p>
                <p><strong>Virtual Tuner Audio:</strong> Preserve non-AC-4 audio codecs or transcode those tracks to AC-3/E-AC-3.</p>
                <p><strong>AC-4 Audio:</strong> Preserve AC-4 for compatible receivers, or transcode it to AC-3/E-AC-3. AC-3 is the default.</p>
                <p><strong>Virtual Tuner Video:</strong> Preserve HEVC by default, or transcode it to H.264 for compatibility at the cost of CPU and generation loss.</p>
                <hr />
                <h6>Web Player</h6>
                <p><strong>Web Video Preset:</strong> Controls the CPU-versus-compression tradeoff for the Watch player. Very fast is recommended.</p>
                <p><strong>Web Video Quality:</strong> Controls H.264 quality using CRF. Lower values improve quality and increase bitrate. The default is 21.</p>
                }
                else if (_activeTab == SettingsTab.Api)
                {
                <h6>Status API</h6>
                <p><strong>Endpoint:</strong> <code>GET /api/v1/status</code> returns cached guide, device, tuner, and active-stream state for dashboards.</p>
                <p><strong>Privacy:</strong> Redacted fields remain present as <code>null</code>, preserving the stable response shape.</p>
                <p>The endpoint does not trigger device discovery, guide downloads, tuner refreshes, or other control operations.</p>
                }
                else if (_activeTab == SettingsTab.Logging)
                {
                <h6>Application Log Filters</h6>
                <p>Startup filters come from the effective <code>Logging:LogLevel</code> configuration. Enable the override to edit the default level, adjust discovered category prefixes, or add custom prefixes.</p>
                <p>Overrides apply immediately to every output. Turning the override off immediately restores the complete startup filter set.</p>
                <hr />
                <h6>Local Diagnostics</h6>
                <p>The Logs page always displays a bounded view from the current process. File logging adds restart-persistent rolling files under Lineup-owned storage.</p>
                <p>Enabling, disabling, or changing file logging takes effect immediately when settings are saved.</p>
                <hr />
                <h6>External Targets</h6>
                <p>Vendor-neutral OTLP export is opt-in and configured outside the Web UI so secrets are not persisted in <code>settings.json</code>.</p>
                }
                else
                {
                <h6>Reset Settings</h6>
                <p>Stages the default configuration for review. Nothing changes on disk until you click Save Settings.</p>
                <hr />
                <h6>Restart Lineup</h6>
                <p>Gracefully restarts the application without changing settings or deleting data.</p>
                <hr />
                <h6>Factory Reset</h6>
                <p>Permanently erases Lineup-owned settings, guide data, and caches before restarting into first-run Device setup.</p>
                <p>External XMLTV files outside Lineup-owned storage are preserved.</p>
                }
                <hr />
                <p class="text-muted mb-0">
                    <small>Settings are saved to <code>settings.json</code> and persist across restarts.</small>
                </p>
            </div>
        </div>
    </div>
</div>
