@page "/watch"
@page "/watch/{ChannelNumber}"
@using Lineup.HDHomeRun.Api.Models
@using Lineup.Web.Services
@rendermode InteractiveServer

<PageTitle>Watch TV</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1><span class="bi bi-play-circle me-2"></span>Watch TV</h1>
    <div class="d-flex align-items-center gap-2">
        <label for="streamQuality" class="form-label mb-0">Quality</label>
        <select id="streamQuality" class="form-select form-select-sm w-auto" value="@_quality" @onchange="ChangeQuality">
            <option value="@WebPlayerQuality.AppDefault">App Default</option>
            <option value="@WebPlayerQuality.High">High</option>
            <option value="@WebPlayerQuality.Medium">Medium (720p)</option>
            <option value="@WebPlayerQuality.Low">Low (480p)</option>
        </select>
        @if (_activeStream?.Tracks.Where(track => track.Type == MediaTrackType.Audio).ToArray() is { Length: > 0 } audioTracks)
        {
            <label for="audioTrack" class="form-label mb-0">Audio</label>
            <select id="audioTrack" class="form-select form-select-sm w-auto" value="@_audioTrack" @onchange="ChangeAudioTrack">
                @foreach (var track in audioTracks)
                {
                    <option value="@track.SourceIndex">@FormatTrackLabel(track)</option>
                }
            </select>
        }
        @if (_activeStream?.Tracks.Where(track => track.Type == MediaTrackType.Subtitle).ToArray() is { Length: > 0 } subtitleTracks)
        {
            <label for="subtitleTrack" class="form-label mb-0">Subtitles</label>
            <select id="subtitleTrack" class="form-select form-select-sm w-auto" value="@(_subtitleTrack?.ToString() ?? "-1")" @onchange="ChangeSubtitleTrack">
                <option value="-1">Off</option>
                @foreach (var track in subtitleTracks)
                {
                    <option value="@track.SourceIndex" disabled="@(track.SubtitlePresentation == SubtitlePresentation.Unsupported)">
                        @FormatTrackLabel(track)@(track.SubtitlePresentation == SubtitlePresentation.BurnIn ? " (burn-in; higher CPU)" : "")
                    </option>
                }
            </select>
        }
        @if (_isPlaying)
        {
            <button class="btn btn-danger" @onclick="StopStream">
                <span class="bi bi-stop-fill me-1"></span>Stop
            </button>
        }
    </div>
</div>


<div class="row">
<!-- Video Player -->
<div class="col-lg-9 mb-4">
    <div class="card">
        <div class="card-body p-0">
            @if (_isPlaying && !string.IsNullOrEmpty(_streamUrl))
            {
                <div class="ratio ratio-16x9 bg-dark">
                    <video id="videoPlayer" 
                           controls 
                           autoplay
                           muted
                           class="w-100">
                        Your browser does not support HLS video playback.
                    </video>
                </div>
                <div class="p-3 border-top">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="mb-1">
                                <span class="badge bg-primary me-2">@_selectedChannelNumber</span>
                                @(_selectedChannel?.GuideName ?? "Manual Tune")
                            </h5>
                            @if (_currentProgram != null)
                                {
                                    <p class="text-muted mb-0">
                                        <strong>Now Playing:</strong> @_currentProgram.Title
                                        @if (!string.IsNullOrEmpty(_currentProgram.EpisodeTitle))
                                        {
                                            <span> - @_currentProgram.EpisodeTitle</span>
                                        }
                                    </p>
                                }
                            </div>
                            <div class="text-muted small">
                                <span class="bi bi-broadcast text-success me-1"></span>Live
                            </div>
                        </div>
                    </div>
                }
                else if (IsContentProtectedError)
                {
                    <div class="ratio ratio-16x9 bg-dark">
                        <div class="d-flex align-items-center justify-content-center">
                            <div class="text-center text-white px-4">
                                <span class="bi bi-shield-lock display-1 text-warning"></span>
                                <h3 class="mt-3 mb-2">Content Protected</h3>
                                <p class="lead mb-2">
                                    Channel @_selectedChannelNumber
                                    @if (!string.IsNullOrWhiteSpace(_selectedChannel?.GuideName))
                                    {
                                        <span> @_selectedChannel.GuideName</span>
                                    }
                                </p>
                                <p class="text-white-50 mb-0">
                                    The broadcaster requires DRM playback. Use an authorized device or application that supports this channel's content protection.
                                </p>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="ratio ratio-16x9 bg-dark d-flex align-items-center justify-content-center">
                        <div class="text-center text-white-50">
                            <span class="bi bi-tv display-1"></span>
                            <p class="mt-3">Select a channel to start watching</p>
                            <p class="small">
                                <span class="bi bi-info-circle me-1"></span>
                                Streams directly with FFmpeg (no disk I/O)
                            </p>
                        </div>
                    </div>
                }
            </div>
        </div>
        
        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="alert alert-danger mt-3">
                <h6 class="alert-heading">
                    <span class="bi bi-exclamation-triangle me-2"></span>
                    Stream Error
                </h6>
                <pre class="mb-0 small" style="white-space: pre-wrap;">@_errorMessage</pre>
            </div>
        }
        
        @if (_showCodecError)
        {
            <div class="alert alert-danger mt-3">
                <h6 class="alert-heading">
                    <span class="bi bi-exclamation-octagon me-2"></span>
                    Audio Codec Not Supported
                </h6>
                <p class="mb-2">
                    Your browser cannot play AC-3 (Dolby Digital) audio. The transcoding may not be working correctly.
                </p>
                <hr />
                <p class="mb-2"><strong>Try these troubleshooting steps:</strong></p>
                <ul class="mb-2">
                    <li>Try a different <strong>Quality setting</strong> above (mobile, internet720, etc.)</li>
                    <li>Check that transcoding is enabled in your HDHomeRun settings at <a href="http://@(SettingsService.Settings.DeviceAddress)/" target="_blank">http://@(SettingsService.Settings.DeviceAddress)/</a></li>
                    <li>Verify no other apps are using all the transcode slots</li>
                    <li>Use <strong>VLC Media Player</strong> with the direct stream URL below</li>
                </ul>
                @if (_selectedChannelNumber is { } selectedChannelNumber)
                {
                    <p class="mb-0">
                        <strong>Direct Stream URL for VLC:</strong><br/>
                        <code class="user-select-all">http://@(SettingsService.Settings.DeviceAddress):5004/auto/v@(selectedChannelNumber)</code>
                        <button class="btn btn-sm btn-outline-secondary ms-2" @onclick="CopyStreamUrlToClipboard">
                            <span class="bi bi-clipboard"></span> Copy
                        </button>
                    </p>
                }
            </div>
        }
        
        
        
        <div class="card mt-3">
            <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                <h6 class="mb-0"><span class="bi bi-info-circle me-1"></span>Stream Information</h6>
            </div>
            <div class="card-body">
                <p class="mb-2"><strong>Device Address:</strong> <code>@SettingsService.Settings.DeviceAddress</code></p>
                @if (_selectedChannelNumber is { } streamInfoChannelNumber)
                {
                    <p class="mb-2"><strong>Device Stream:</strong> <code>http://@(SettingsService.Settings.DeviceAddress):5004/auto/v@(streamInfoChannelNumber)</code></p>
                    @if (!string.IsNullOrEmpty(_streamUrl))
                    {
                        <p class="mb-2"><strong>Transcode URL:</strong> <code>@_streamUrl</code></p>
                    }
                }
                <p class="@(_selectedChannelNumber == null ? "mb-0" : "mb-3")">
                    <strong>Player:</strong> 
                    <span class="badge bg-success">Fragmented MP4</span>
                    <span class="badge bg-info ms-1">FFmpeg (Memory)</span>
                    <span class="text-muted small ms-2">(H.264 + AAC, no disk I/O)</span>
                </p>

                @if (_selectedChannelNumber != null)
                {
                    <div class="row g-3">
                        <div class="col-md-6">
                            <h6><span class="bi bi-reception-4 me-1"></span>Tuner</h6>
                            @if (SelectedTuner is { } tuner)
                            {
                                <table class="table table-sm table-borderless mb-0">
                                    <tbody>
                                        <tr><th scope="row">Tuner</th><td>@tuner.TunerIndex</td></tr>
                                        <tr>
                                            <th scope="row">Status</th>
                                            <td>
                                                <span class="badge @(tuner.IsStreaming ? "bg-success" : "bg-info")">
                                                    @(tuner.IsStreaming ? "Streaming" : "Tuned")
                                                </span>
                                            </td>
                                        </tr>
                                        <tr><th scope="row">Lock</th><td>@(tuner.LockType ?? "none")</td></tr>
                                        <tr><th scope="row">Signal</th><td>@tuner.SignalStrength% · SNQ @tuner.SignalToNoiseQuality% · SEQ @tuner.SymbolErrorQuality%</td></tr>
                                        <tr><th scope="row">Rate</th><td>@FormatBitRate(tuner.BitsPerSecond) · @tuner.PacketsPerSecond pps</td></tr>
                                    </tbody>
                                </table>
                            }
                            else
                            {
                                <p class="small text-muted mb-0">No active tuner is currently reporting this channel.</p>
                            }
                        </div>
                        <div class="col-md-6">
                            <h6><span class="bi bi-broadcast-pin me-1"></span>Hosted Stream</h6>
                            @if (_activeStream is not null)
                            {
                                <p class="small mb-1">
                                    <strong>Session:</strong> <code>@_activeStream.SessionId</code>
                                    <span class="badge bg-info ms-1">@_activeStream.Format</span>
                                </p>
                                @foreach (var track in _activeStream.Tracks)
                                {
                                    <div class="small mb-1">
                                        <span class="badge @(track.Type == MediaTrackType.Video ? "bg-primary" : "bg-secondary") me-1">@track.Type</span>
                                        @FormatSourceTrack(track)
                                        <span class="bi bi-arrow-right mx-1"></span>
                                        @FormatOutputTrack(track)
                                        @if (track.IsSelected)
                                        {
                                            <span class="badge bg-success ms-1">selected</span>
                                        }
                                    </div>
                                }
                                @if (_activeStream.SourceBitRate.HasValue)
                                {
                                    <p class="small text-muted mb-0">Source total: @FormatBitRate(_activeStream.SourceBitRate)</p>
                                }
                            }
                            else
                            {
                                <p class="small text-muted mb-0">Waiting for hosted stream metadata.</p>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
    
    <!-- Channel List -->
    <div class="col-lg-3">
        <div class="card">
            <div class="card-header">
                <h6 class="mb-0"><span class="bi bi-list-ul me-1"></span>Channels</h6>
            </div>
            <div class="card-body p-0">
                <form class="p-3 border-bottom" @onsubmit="ManualTuneAsync" @onsubmit:preventDefault="true">
                    <label for="manualTuneChannel" class="form-label">Manual Tune</label>
                    <div class="input-group input-group-sm">
                        <input id="manualTuneChannel"
                               class="form-control"
                               type="text"
                               inputmode="decimal"
                               autocomplete="off"
                               placeholder="Channel number"
                               aria-describedby="manualTuneHelp"
                               aria-invalid="@(_manualTuneValidationMessage != null ? "true" : "false")"
                               value="@_manualChannelNumber"
                               @oninput="UpdateManualChannelNumber" />
                        <button id="manualTuneButton" class="btn btn-primary" type="submit">
                            <span class="bi bi-play-fill me-1"></span>Tune
                        </button>
                    </div>
                    <div id="manualTuneHelp" class="@(_manualTuneValidationMessage == null ? "form-text" : "invalid-feedback d-block")">
                        @(_manualTuneValidationMessage ?? "Tune a virtual channel even when guide data is unavailable.")
                    </div>
                </form>
                @if (_isLoadingChannels)
                {
                    <div class="text-center py-4">
                        <div class="spinner-border spinner-border-sm text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <p class="text-muted small mt-2 mb-0">Loading channels...</p>
                    </div>
                }
                else if (_channels.Count == 0)
                {
                    <div class="text-center py-4">
                        <span class="bi bi-info-circle text-muted"></span>
                        <p class="text-muted small mt-2 mb-0">No guide channels available.<br/>Enter a channel number above to tune manually.</p>
                    </div>
                }
                else
                {
                    <div class="channel-list">
                        @foreach (var channel in _channels)
                        {
                            var isSelected = _selectedChannelNumber == channel.GuideNumber;
                            var nowPlaying = GetCurrentProgram(channel.GuideNumber);
                            
                            <div class="channel-item @(isSelected ? "active" : "")" 
                                 @onclick="() => SelectChannel(channel)">
                                <div class="d-flex align-items-center">
                                    <div class="channel-number me-2">@channel.GuideNumber</div>
                                    <div class="flex-grow-1 overflow-hidden">
                                        <div class="channel-name">
                                            @channel.GuideName
                                            @if (channel.DRM)
                                            {
                                                <span class="bi bi-shield-lock-fill text-warning ms-1" title="DRM-protected channel" aria-label="DRM-protected channel"></span>
                                            }
                                        </div>
                                        @if (nowPlaying != null)
                                        {
                                            <div class="now-playing text-truncate">@nowPlaying.Title</div>
                                        }
                                    </div>
                                    @if (isSelected && _isPlaying)
                                    {
                                        <span class="bi bi-broadcast text-success ms-2"></span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<style>
    .channel-list {
        max-height: 600px;
        overflow-y: auto;
    }
    
    .channel-item {
        padding: 0.75rem 1rem;
        border-bottom: 1px solid #dee2e6;
        cursor: pointer;
        transition: background-color 0.15s;
    }
    
    .channel-item:hover {
        background-color: #f8f9fa;
    }
    
    .channel-item.active {
        background-color: #e7f1ff;
        border-left: 3px solid #0d6efd;
    }
    
    .channel-item:last-child {
        border-bottom: none;
    }
    
    .channel-number {
        font-weight: bold;
        color: #0d6efd;
        min-width: 40px;
    }
    
    .channel-name {
        font-weight: 500;
        font-size: 0.9rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    
    .now-playing {
        font-size: 0.75rem;
        color: #6c757d;
    }
    
    video {
        background-color: #000;
    }
</style>
