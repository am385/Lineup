@page "/watch"
@page "/watch/{ChannelNumber}"
@using Lineup.Web.Services

<PageTitle>Watch TV</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1><span class="bi bi-play-circle me-2"></span>Watch TV</h1>
        <p class="text-muted mb-0">Live TV with adaptive HLS and DASH playback</p>
    </div>
    <div class="d-flex flex-wrap justify-content-end align-items-center gap-2">
        @if (_preferencesRestored && _compatibilityProfile is null)
        {
            <a id="runCmafCompatibilityTests" class="btn btn-outline-primary btn-sm" href="/watch-test?runAll=true">
                <span class="bi bi-speedometer2 me-1"></span>Run Compatibility Tests
            </a>
        }
        <div class="form-check form-switch mb-0">
            <input id="cmafOverrideStreamSettings" class="form-check-input" type="checkbox" checked="@_streamOverrides.Enabled" @onchange="ChangeOverrideEnabled">
            <label for="cmafOverrideStreamSettings" class="form-check-label">Override stream settings</label>
        </div>
        <div id="cmafOverrideSettings" class="d-flex flex-wrap align-items-center gap-2 @(_streamOverrides.Enabled ? null : "d-none")">
            <label for="cmafProtocol" class="form-label mb-0">Protocol</label>
            <select id="cmafProtocol" class="form-select form-select-sm w-auto" value="@OverrideProtocolValue" @onchange="ChangeProtocol">
                <option value="">Browser profile</option>
                <option value="@CmafPlaybackProtocol.Hls">HLS</option>
                <option value="@CmafPlaybackProtocol.Dash">DASH</option>
            </select>
            <label for="cmafQuality" class="form-label mb-0">Quality</label>
            <select id="cmafQuality" class="form-select form-select-sm w-auto" value="@OverrideQualityValue" @onchange="ChangeQuality">
                <option value="">Browser profile</option>
                <option value="@WebPlayerQuality.AppDefault">App Default</option>
                <option value="@WebPlayerQuality.High">High</option>
                <option value="@WebPlayerQuality.Medium">Medium (720p)</option>
                <option value="@WebPlayerQuality.Low">Low (480p)</option>
            </select>
            <label for="cmafPreferredVideo" class="form-label mb-0">Preferred Video</label>
            <select id="cmafPreferredVideo" class="form-select form-select-sm w-auto" value="@OverrideVideoValue" @onchange="ChangePreferredVideo">
                <option value="">Browser profile</option>
                <option value="@CmafPreferredVideo.Source">Source</option>
                <option value="@CmafPreferredVideo.Fallback">H.264 Fallback</option>
            </select>
            <label for="cmafPreferredAudio" class="form-label mb-0">Preferred Audio</label>
            <select id="cmafPreferredAudio" class="form-select form-select-sm w-auto" value="@OverrideAudioValue" @onchange="ChangePreferredAudio">
                <option value="">Browser profile</option>
                <option value="@CmafPreferredAudio.Source">Source</option>
                <option value="@CmafPreferredAudio.Fallback">Fallback</option>
            </select>
            <label for="cmafFallbackAudio" class="form-label mb-0">Fallback Audio</label>
            <select id="cmafFallbackAudio" class="form-select form-select-sm w-auto" value="@OverrideFallbackAudioValue" @onchange="ChangeFallbackAudio">
                <option value="">Browser profile</option>
                <option value="@CmafFallbackAudio.Eac3">EAC3</option>
                <option value="@CmafFallbackAudio.Ac3">AC3</option>
                <option value="@CmafFallbackAudio.AacUpTo7Point1">AAC up to 7.1</option>
                <option value="@CmafFallbackAudio.AacUpTo5Point1">AAC up to 5.1</option>
                <option value="@CmafFallbackAudio.AacStereo">AAC Stereo</option>
            </select>
        </div>
        @if (_activeStream?.Tracks
            .Where(track => track.Type == MediaTrackType.Subtitle && track.SubtitlePresentation == SubtitlePresentation.BurnIn)
            .DistinctBy(track => track.SourceIndex)
            .ToArray() is { Length: > 0 } subtitleTracks)
        {
            <label for="cmafSubtitleTrack" class="form-label mb-0">Bitmap subtitles</label>
            <select id="cmafSubtitleTrack" class="form-select form-select-sm w-auto"
                    value="@(_subtitlePresentation == SubtitlePresentation.BurnIn ? _subtitleTrack?.ToString() : "-1")"
                    @onchange="ChangeSubtitleTrack">
                <option value="-1">Off</option>
                @foreach (var track in subtitleTracks)
                {
                    <option value="@track.SourceIndex">@FormatTrackLabel(track) (burn-in; higher CPU)</option>
                }
            </select>
        }
        @if (_isPlaying)
        {
            <button class="btn btn-danger" @onclick="StopStreamAsync">
                <span class="bi bi-stop-fill me-1"></span>Stop
            </button>
        }
    </div>
</div>

<div class="row">
    <div class="col-lg-9 mb-4">
        <div class="card">
            <div class="card-body p-0">
                @if (_isPlaying && _session is not null)
                {
                    <div class="ratio ratio-16x9 bg-dark shaka-video-container" data-lineup-cmaf-container>
                        <video id="cmafVideoPlayer" autoplay muted class="w-100 shaka-video">
                            Your browser does not support adaptive playback.
                        </video>
                        @if (_isPlayerLoading)
                        {
                            <div id="cmafStreamLoading" class="cmaf-loading-overlay text-white" role="status" aria-live="polite">
                                <div class="spinner-border mb-3" aria-hidden="true"></div>
                                <p class="mb-0">Setting up stream...</p>
                            </div>
                        }
                    </div>
                    <div class="p-3 border-top d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="mb-1">
                                <span class="badge bg-primary me-2">@_selectedChannelNumber</span>
                                @(_selectedChannel?.GuideName ?? "Manual Tune")
                            </h5>
                            @if (_currentProgram is not null)
                            {
                                <p class="text-muted mb-0">
                                    <strong>Now Playing:</strong> @_currentProgram.Title
                                    @if (!string.IsNullOrEmpty(_currentProgram.EpisodeTitle))
                                    {
                                        <span> - @_currentProgram.EpisodeTitle</span>
                                    }
                                </p>
                            }
                        </div>
                        <div class="text-muted small">
                            <span class="bi bi-broadcast text-success me-1"></span>@_effectiveProtocol
                        </div>
                    </div>
                }
                else
                {
                    <div class="ratio ratio-16x9 bg-dark d-flex align-items-center justify-content-center">
                        @if (_isPlayerLoading)
                        {
                            <div id="cmafStreamLoading" class="cmaf-loading-overlay text-white" role="status" aria-live="polite">
                                <div class="spinner-border mb-3" aria-hidden="true"></div>
                                <p class="mb-0">Setting up stream...</p>
                            </div>
                        }
                        else
                        {
                            <div class="text-center text-white-50">
                                <span class="bi bi-broadcast-pin display-1"></span>
                                <p class="mt-3">Select a channel to start watching</p>
                                <p class="small">One shared fragment set serves both HLS and DASH.</p>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <div class="alert alert-danger mt-3" role="alert">
                <h6 class="alert-heading"><span class="bi bi-exclamation-triangle me-2"></span>Stream Error</h6>
                <pre class="mb-0 small" style="white-space: pre-wrap;">@_errorMessage</pre>
            </div>
        }

        <div class="card mt-3">
            <div class="card-header"><h6 class="mb-0"><span class="bi bi-info-circle me-1"></span>Stream Information</h6></div>
            <div class="card-body">
                <p class="mb-2"><strong>Device Address:</strong> <code>@SettingsService.Settings.DeviceAddress</code></p>
                @if (_selectedChannelNumber is { } streamInfoChannelNumber)
                {
                    <p class="mb-2"><strong>Device Stream:</strong> <code>http://@(SettingsService.Settings.DeviceAddress):5004/auto/v@(streamInfoChannelNumber)</code></p>
                }
                <p class="@(_selectedChannelNumber is null ? "mb-0" : "mb-3")">
                    <strong>Player:</strong>
                    <span class="badge bg-success">CMAF/fMP4</span>
                    <span class="badge bg-info ms-1">FFmpeg (Shared Segments)</span>
                    <span class="text-muted small ms-2">(HLS + DASH)</span>
                </p>
                @if (_session is not null)
                {
                    <p class="small mb-1"><strong>Session:</strong> <code>@_session.SessionId</code></p>
                    <p class="small mb-1"><strong>DASH:</strong> <code>@_session.DashManifestUrl</code></p>
                    <p class="small mb-3"><strong>HLS:</strong> <code>@_session.HlsManifestUrl</code></p>
                }
                @if (_selectedChannelNumber is not null)
                {
                    <div class="row g-3">
                        <div class="col-md-6">
                            <h6><span class="bi bi-reception-4 me-1"></span>Tuner</h6>
                            @if (SelectedTuner is { } tuner)
                            {
                                <table class="table table-sm table-borderless mb-0">
                                    <tbody>
                                        <tr><th scope="row">Tuner</th><td>@tuner.TunerIndex</td></tr>
                                        <tr>
                                            <th scope="row">Status</th>
                                            <td>
                                                <span class="badge @(tuner.IsStreaming ? "bg-success" : "bg-info")">
                                                    @(tuner.IsStreaming ? "Streaming" : "Tuned")
                                                </span>
                                            </td>
                                        </tr>
                                        <tr><th scope="row">Lock</th><td>@(tuner.LockType ?? "none")</td></tr>
                                        <tr><th scope="row">Signal</th><td>@tuner.SignalStrength% · SNQ @tuner.SignalToNoiseQuality% · SEQ @tuner.SymbolErrorQuality%</td></tr>
                                        <tr><th scope="row">Rate</th><td>@FormatBitRate(tuner.BitsPerSecond) · @tuner.PacketsPerSecond pps</td></tr>
                                    </tbody>
                                </table>
                            }
                            else
                            {
                                <p class="small text-muted mb-0">No active tuner is currently reporting this channel.</p>
                            }
                        </div>
                        <div class="col-md-6">
                            <h6><span class="bi bi-broadcast-pin me-1"></span>Hosted Stream</h6>
                            @if (_playerVideo is not null)
                            {
                                <p class="small mb-1">
                                    <strong>Playing video:</strong>
                                    @string.Join(" · ", new[] { _playerVideo.Codec, _playerVideo.Width.HasValue && _playerVideo.Height.HasValue ? $"{_playerVideo.Width}x{_playerVideo.Height}" : null }
                                        .Where(value => !string.IsNullOrWhiteSpace(value)))
                                </p>
                            }
                            @if (_playerAudio is not null)
                            {
                                <p class="small mb-1">
                                    <strong>Playing audio:</strong>
                                    @string.Join(" · ", new[] { _playerAudio.Label, _playerAudio.Codec, _playerAudio.Channels.HasValue ? $"{_playerAudio.Channels} ch" : null }
                                        .Where(value => !string.IsNullOrWhiteSpace(value)))
                                </p>
                            }
                            @if (_activeStream is not null)
                            {
                                <p class="small mb-1">
                                    <strong>Session:</strong> <code>@_activeStream.SessionId</code>
                                    <span class="badge bg-info ms-1">CMAF</span>
                                </p>
                                <p class="small mb-1">
                                    <strong>Playback protocol:</strong> @_effectiveProtocol
                                </p>
                                @foreach (var track in _activeStream.Tracks)
                                {
                                    <div class="small mb-1">
                                        <span class="badge @(track.Type == MediaTrackType.Video ? "bg-primary" : "bg-secondary") me-1">@track.Type</span>
                                        @FormatSourceTrack(track)
                                        <span class="bi bi-arrow-right mx-1"></span>
                                        @FormatOutputTrack(track)
                                        @if (IsPlayingTrack(track))
                                        {
                                            <span class="badge bg-success ms-1">playing</span>
                                        }
                                        else if (IsWebVttSidecar(track))
                                        {
                                            <span class="badge bg-info ms-1">sidecar</span>
                                        }
                                        else if (track.IsSelected)
                                        {
                                            <span class="badge bg-secondary ms-1">included</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-dark ms-1">not included</span>
                                        }
                                    </div>
                                }
                                @if (_activeStream.SourceBitRate.HasValue)
                                {
                                    <p class="small text-muted mb-0">Source total: @FormatBitRate(_activeStream.SourceBitRate)</p>
                                }
                            }
                            else
                            {
                                <p class="small text-muted mb-0">Waiting for hosted stream metadata.</p>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-3">
        <div class="card">
            <div class="card-header"><h6 class="mb-0"><span class="bi bi-list-ul me-1"></span>Channels</h6></div>
            <div class="card-body p-0">
                <form class="p-3 border-bottom" @onsubmit="ManualTuneAsync" @onsubmit:preventDefault="true">
                    <label for="cmafManualChannel" class="form-label">Manual Tune</label>
                    <div class="input-group input-group-sm">
                        <input id="cmafManualChannel" class="form-control" type="text" inputmode="decimal" autocomplete="off"
                               placeholder="Channel number" value="@_manualChannelNumber" @oninput="UpdateManualChannelNumber" />
                        <button class="btn btn-primary" type="submit"><span class="bi bi-play-fill me-1"></span>Tune</button>
                    </div>
                    @if (_manualTuneValidationMessage is not null)
                    {
                        <div class="invalid-feedback d-block">@_manualTuneValidationMessage</div>
                    }
                </form>
                @if (_isLoadingChannels)
                {
                    <div class="text-center py-4"><div class="spinner-border spinner-border-sm text-primary" role="status"></div></div>
                }
                else if (_channels.Count == 0)
                {
                    <p class="text-muted small text-center p-3 mb-0">No enabled channels available.</p>
                }
                else
                {
                    <div class="cmaf-channel-list">
                        @foreach (var channel in _channels)
                        {
                            var nowPlaying = GetCurrentProgram(channel.GuideNumber);
                            <button class="cmaf-channel-item @(channel.GuideNumber == _selectedChannelNumber ? "active" : "")"
                                    @onclick="() => TuneChannelAsync(channel.GuideNumber, channel)">
                                <span class="cmaf-channel-number me-2">@channel.GuideNumber</span>
                                <span class="flex-grow-1 overflow-hidden">
                                    <span class="cmaf-channel-name">
                                        @channel.GuideName
                                        @if (channel.Favorite)
                                        {
                                            <span class="bi bi-star-fill text-warning ms-1" title="Favorite channel" aria-label="Favorite channel"></span>
                                        }
                                        @if (channel.DRM)
                                        {
                                            <span class="bi bi-shield-lock-fill text-warning ms-1" title="DRM-protected channel" aria-label="DRM-protected channel"></span>
                                        }
                                    </span>
                                    @if (nowPlaying is not null)
                                    {
                                        <span class="cmaf-now-playing text-truncate">@nowPlaying.Title</span>
                                    }
                                </span>
                                @if (channel.GuideNumber == _selectedChannelNumber && _isPlaying)
                                {
                                    <span class="bi bi-broadcast text-success ms-2"></span>
                                }
                            </button>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>
