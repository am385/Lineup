<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\Core\Lineup.VirtualOutputs.Hosting\Lineup.VirtualOutputs.Hosting.csproj" />
    <ProjectReference Include="..\Lineup.SiliconDust.HDHomeRun.VirtualTuner\Lineup.SiliconDust.HDHomeRun.VirtualTuner.csproj" />
  </ItemGroup>
  <Target Name="WriteVirtualOutputManifest" AfterTargets="Build">
    <GetFileHash Files="$(TargetPath)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_WorkerHashItem" />
    </GetFileHash>
    <PropertyGroup>
      <_WorkerHash>@(_WorkerHashItem->'%(FileHash)')</_WorkerHash>
      <_WorkerManifest>{"schemaVersion":1,"workerId":"hdhomerun","version":"$(Version)","publisher":"Lineup","executablePath":"$(TargetFileName)","executableSha256":"$(_WorkerHash)","adapterKinds":["hdhomerun"],"platforms":[],"minimumProtocolVersion":1,"maximumProtocolVersion":1,"minimumLineupVersion":"$(Version)","settingsDescriptor":{"adapterKind":"hdhomerun","fields":[]}}</_WorkerManifest>
    </PropertyGroup>
    <WriteLinesToFile File="$(TargetDir)hdhomerun.virtual-output.json" Lines="$(_WorkerManifest)" Overwrite="true" />
  </Target>
</Project>
