<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\Core\Lineup.VirtualOutputs.Hosting\Lineup.VirtualOutputs.Hosting.csproj" />
    <ProjectReference Include="..\Lineup.WebPlayer\Lineup.WebPlayer.csproj" />
    <ProjectReference Include="..\Lineup.WebPlayer.FFmpeg\Lineup.WebPlayer.FFmpeg.csproj" />
  </ItemGroup>
  <Target Name="WriteVirtualOutputManifest" AfterTargets="Build">
    <GetFileHash Files="$(TargetPath)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_WorkerHashItem" />
    </GetFileHash>
    <PropertyGroup>
      <_WorkerHash>@(_WorkerHashItem->'%(FileHash)')</_WorkerHash>
      <_WorkerManifest>{"schemaVersion":1,"workerId":"web-player","version":"$(Version)","publisher":"Lineup","executablePath":"$(TargetFileName)","executableSha256":"$(_WorkerHash)","adapterKinds":["web-player"],"platforms":[],"minimumProtocolVersion":1,"maximumProtocolVersion":2,"minimumLineupVersion":"$(Version)","settingsDescriptor":{"adapterKind":"web-player","fields":[]}}</_WorkerManifest>
    </PropertyGroup>
    <WriteLinesToFile File="$(TargetDir)web-player.virtual-output.json" Lines="$(_WorkerManifest)" Overwrite="true" />
  </Target>
</Project>
